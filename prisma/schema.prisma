model SalesCadence {
  id         String   @id @default(uuid())
  name       String
  status     String   @default("DRAFT") // DRAFT, ACTIVE, PAUSED, ARCHIVED
  type       String   @default("OUTBOUND") // OUTBOUND, INBOUND, EVENT_BASED
  totalSteps Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  steps       SalesCadenceStep[]
  enrollments SalesCadenceEnrollment[]

  @@index([status])
  @@map("sales_cadences")
}

model SalesCadenceStep {
  id        String   @id @default(uuid())
  cadenceId String
  stepOrder Int
  stepType  String // EMAIL, CALL, LINKEDIN, WAIT, CUSTOM
  subject   String?
  body      String?  @db.Text
  waitDays  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cadence SalesCadence @relation(fields: [cadenceId], references: [id], onDelete: Cascade)

  @@index([cadenceId])
  @@map("sales_cadence_steps")
}

model SalesCadenceEnrollment {
  id          String    @id @default(uuid())
  cadenceId   String
  contactId   String?
  leadId      String?
  currentStep Int       @default(1)
  status      String    @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED, REMOVED
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  cadence SalesCadence @relation(fields: [cadenceId], references: [id], onDelete: Cascade)

  @@index([cadenceId])
  @@index([status])
  @@map("sales_cadence_enrollments")
}

model ConversationInsight {
  id          String   @id @default(uuid())
  objectType  String // CALL, MEETING, EMAIL
  objectId    String
  transcript  String?  @db.Text
  sentiment   String? // POSITIVE, NEUTRAL, NEGATIVE
  keyTopics   String[]
  actionItems String[]
  aiSummary   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([objectType, objectId])
  @@map("conversation_insights")
}

// ============================================
// PHASE 2: SERVICE CLOUD ENHANCEMENTS
// ============================================

model CaseMilestone {
  id            String    @id @default(uuid())
  caseId        String
  milestoneName String
  targetDate    DateTime
  completedDate DateTime?
  status        String    @default("OPEN") // OPEN, COMPLETED, VIOLATED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([caseId])
  @@index([status])
  @@map("case_milestones")
}

model EinsteinBot {
  id             String   @id @default(uuid())
  name           String
  status         String   @default("DRAFT") // DRAFT, ACTIVE, INACTIVE
  welcomeMessage String?  @db.Text
  channels       String[] // WEB, FACEBOOK, WHATSAPP, SMS
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  dialogs BotDialog[]

  @@map("einstein_bots")
}

model BotDialog {
  id          String   @id @default(uuid())
  botId       String
  triggerType String   @default("KEYWORD") // KEYWORD, INTENT, PATTERN
  triggers    String[]
  responses   Json // Array of response objects
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bot EinsteinBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId])
  @@map("bot_dialogs")
}

model SocialPost {
  id         String   @id @default(uuid())
  platform   String // TWITTER, FACEBOOK, INSTAGRAM, LINKEDIN
  authorName String
  content    String   @db.Text
  sentiment  String? // POSITIVE, NEUTRAL, NEGATIVE
  caseId     String?
  status     String   @default("NEW") // NEW, IN_PROGRESS, RESPONDED, CLOSED
  response   String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([platform])
  @@index([caseId])
  @@index([status])
  @@map("social_posts")
}

model MessagingConversation {
  id          String   @id @default(uuid())
  channel     String   @default("SMS") // SMS, WHATSAPP, FACEBOOK_MESSENGER
  contactId   String?
  phoneNumber String?
  status      String   @default("ACTIVE") // ACTIVE, CLOSED, PENDING
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages MessagingMessage[]

  @@index([contactId])
  @@index([status])
  @@map("messaging_conversations")
}

model MessagingMessage {
  id             String   @id @default(uuid())
  conversationId String
  direction      String   @default("INBOUND") // INBOUND, OUTBOUND
  content        String   @db.Text
  status         String   @default("SENT") // SENT, DELIVERED, READ, FAILED
  createdAt      DateTime @default(now())

  conversation MessagingConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messaging_messages")
}

// ============================================
// PHASE 2: MARKETING CLOUD ENHANCEMENTS
// ============================================

model ABTest {
  id             String   @id @default(uuid())
  name           String
  status         String   @default("DRAFT") // DRAFT, RUNNING, COMPLETED, CANCELLED
  testType       String   @default("EMAIL") // EMAIL, LANDING_PAGE, SUBJECT_LINE
  variantA       Json // Variant A configuration
  variantB       Json // Variant B configuration
  splitPercent   Int      @default(50) // Percent going to variant A
  winnerCriteria String   @default("OPEN_RATE") // OPEN_RATE, CLICK_RATE, CONVERSION
  results        Json? // Test results
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@map("ab_tests")
}

model LandingPage {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  status          String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  htmlContent     String?  @db.Text
  formConfig      Json? // Form fields configuration
  viewCount       Int      @default(0)
  conversionCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@map("landing_pages")
}

// ============================================
// PHASE 2: PLATFORM ENHANCEMENTS
// ============================================

model DynamicDashboard {
  id        String   @id @default(uuid())
  name      String
  layout    Json // Grid layout configuration
  widgets   Json // Widget definitions
  isDefault Boolean  @default(false)
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("dynamic_dashboards")
}

model ValidationRule {
  id           String   @id @default(uuid())
  name         String
  objectType   String
  formula      String   @db.Text
  errorMessage String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([objectType])
  @@index([isActive])
  @@map("validation_rules")
}

// ============================================
// PHASE 2: ADDITIONAL MODULES
// ============================================

model LoyaltyProgram {
  id              String   @id @default(uuid())
  name            String
  status          String   @default("DRAFT") // DRAFT, ACTIVE, PAUSED, ENDED
  pointsPerDollar Float    @default(1)
  redemptionRate  Float    @default(0.01) // Dollar value per point
  tierEnabled     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tiers   LoyaltyTier[]
  members LoyaltyMember[]

  @@map("loyalty_programs")
}

model LoyaltyTier {
  id        String   @id @default(uuid())
  programId String
  name      String
  minPoints Int      @default(0)
  benefits  Json // Array of benefit descriptions
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@map("loyalty_tiers")
}

model LoyaltyMember {
  id             String   @id @default(uuid())
  programId      String
  contactId      String?
  currentPoints  Int      @default(0)
  lifetimePoints Int      @default(0)
  currentTier    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  program      LoyaltyProgram       @relation(fields: [programId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@index([programId])
  @@index([contactId])
  @@map("loyalty_members")
}

model LoyaltyTransaction {
  id          String   @id @default(uuid())
  memberId    String
  type        String // EARN, REDEEM, ADJUST, EXPIRE
  points      Int
  description String?
  createdAt   DateTime @default(now())

  member LoyaltyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("loyalty_transactions")
}

model GeoLocation {
  id         String   @id @default(uuid())
  objectType String // ACCOUNT, CONTACT, TERRITORY, WORK_ORDER
  objectId   String
  latitude   Float
  longitude  Float
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([objectType, objectId])
  @@map("geo_locations")
}

model BookingCalendar {
  id           String   @id @default(uuid())
  name         String
  type         String   @default("PERSONAL") // PERSONAL, TEAM, SERVICE
  ownerId      String
  duration     Int      @default(30) // Default appointment duration in minutes
  availability Json // Available time slots configuration
  publicToken  String   @unique @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings Booking[]

  @@index([ownerId])
  @@map("booking_calendars")
}

model Booking {
  id          String   @id @default(uuid())
  calendarId  String
  bookerName  String
  bookerEmail String
  startTime   DateTime
  endTime     DateTime
  status      String   @default("CONFIRMED") // CONFIRMED, CANCELLED, COMPLETED, NO_SHOW
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  calendar BookingCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@index([calendarId])
  @@index([startTime])
  @@map("bookings")
}

// ============================================
// WEBHOOK SYSTEM
// ============================================

model WebhookSubscription {
  id        String   @id @default(uuid())
  /// Human-readable label for this subscription
  name      String?
  /// Target URL that receives POST payloads
  url       String
  /// Comma-separated event types, e.g. "lead.created,deal.closed"
  events    String[]
  /// Optional HMAC secret for payload signing
  secret    String?
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([isActive])
  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String   @id @default(uuid())
  subscriptionId String
  eventType      String
  payload        Json
  /// HTTP status returned by the target (null if never reached)
  statusCode     Int?
  /// Raw response body from the target (truncated to 2000 chars)
  responseBody   String?  @db.Text
  /// Whether delivery was ultimately successful
  success        Boolean  @default(false)
  /// Number of attempts made (including retries)
  attempts       Int      @default(0)
  /// Next scheduled retry (null if done)
  nextRetryAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([eventType])
  @@index([success])
  @@index([nextRetryAt])
  @@map("webhook_deliveries")
}
