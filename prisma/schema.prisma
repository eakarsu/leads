// This is your Prisma schema file for LeadGenFlow AI
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ACCOUNT_MANAGER
  CAMPAIGN_SPECIALIST
  CLIENT
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum CampaignChannel {
  EMAIL
  LINKEDIN
  COLD_CALL
  PAID_ADS
  MULTI_CHANNEL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  WON
  LOST
}

enum ActivityType {
  EMAIL
  CALL
  LINKEDIN
  MEETING
  NOTE
}

enum BusinessSector {
  HOME_SERVICES
  LEGAL_SERVICES
  FINANCIAL_SERVICES
  REAL_ESTATE
  HEALTHCARE
  B2B_SAAS
  EDUCATION
  AUTOMOTIVE
  HOSPITALITY
  FITNESS_WELLNESS
  CONSTRUCTION
  ECOMMERCE
  INSURANCE
  SOLAR_ENERGY
  GENERAL
}

enum OpportunityStage {
  PROSPECTING
  QUALIFICATION
  NEEDS_ANALYSIS
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DEFERRED
  WAITING
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EmailStatus {
  DRAFT
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  hashedPassword String
  name           String
  role           UserRole @default(CLIENT)
  clientId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  client           ClientCompany?    @relation(fields: [clientId], references: [id])
  ownedCampaigns   Campaign[]
  activities       LeadActivity[]
  createdThreads   MessageThread[]
  sentMessages     Message[]
  submittedLeads   Lead[]
  ownedOpportunities Opportunity[]
  assignedTasks    Task[]           @relation("AssignedTasks")
  createdTasks     Task[]           @relation("CreatedTasks")
  events           Event[]
  sentEmails       Email[]
  contacts         Contact[]
  createdNotes     Note[]           @relation("CreatedNotes")
  uploadedAttachments Attachment[]  @relation("UploadedAttachments")
  notifications    Notification[]
  createdProcessFlows ProcessFlow[] @relation("CreatedProcessFlows")

  @@index([clientId])
  @@map("users")
}

model ClientCompany {
  id             String         @id @default(uuid())
  name           String
  industry       String
  businessSector BusinessSector @default(GENERAL)
  website        String?
  contactName    String
  contactEmail   String
  contactPhone   String?
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  users          User[]
  campaigns      Campaign[]
  leads          Lead[]
  reports        ReportSnapshot[]
  messageThreads MessageThread[]
  opportunities  Opportunity[]
  contacts       Contact[]
  territories    Territory[]
  products       Product[]

  @@map("client_companies")
}

model Campaign {
  id            String          @id @default(uuid())
  clientId      String
  name          String
  description   String?         @db.Text
  status        CampaignStatus  @default(DRAFT)
  channel       CampaignChannel
  targetPersona String?         @db.Text
  targetRegions String?
  startDate     DateTime?
  endDate       DateTime?
  ownerId       String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  client  ClientCompany    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  owner   User             @relation(fields: [ownerId], references: [id])
  leads   Lead[]
  reports ReportSnapshot[]

  @@index([clientId])
  @@index([ownerId])
  @@index([status])
  @@map("campaigns")
}

enum LeadSource {
  AGENCY
  CLIENT_SUBMITTED
  IMPORTED
  API
  MANUAL
}

model Lead {
  id                 String     @id @default(uuid())
  campaignId         String?
  clientId           String
  fullName           String
  company            String?
  title              String?
  email              String?
  phone              String?
  linkedinUrl        String?
  website            String?
  source             String?
  leadSource         LeadSource @default(AGENCY)
  submittedBy        String?
  status             LeadStatus @default(NEW)
  qualificationScore Int        @default(0)
  notes              String?    @db.Text
  customFields       Json?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Relations
  campaign        Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  client          ClientCompany     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  submitter       User?             @relation(fields: [submittedBy], references: [id])
  activities      LeadActivity[]
  enrichmentData  EnrichmentData[]
  convertedOpportunity Opportunity?

  @@index([campaignId])
  @@index([clientId])
  @@index([status])
  @@index([qualificationScore])
  @@index([leadSource])
  @@map("leads")
}

model LeadActivity {
  id        String       @id @default(uuid())
  leadId    String
  type      ActivityType
  timestamp DateTime     @default(now())
  userId    String
  content   String       @db.Text
  aiSummary String?      @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([userId])
  @@index([type])
  @@map("lead_activities")
}

model EnrichmentData {
  id          String   @id @default(uuid())
  leadId      String
  companySize String?
  industry    String?
  techStack   String?
  location    String?
  extra       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("enrichment_data")
}

model ReportSnapshot {
  id          String   @id @default(uuid())
  clientId    String
  campaignId  String?
  periodStart DateTime
  periodEnd   DateTime
  metrics     Json
  aiSummary   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  client   ClientCompany @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaign Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([campaignId])
  @@map("report_snapshots")
}

model MessageThread {
  id              String   @id @default(uuid())
  clientId        String
  subject         String
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  client    ClientCompany @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User          @relation(fields: [createdByUserId], references: [id])
  messages  Message[]

  @@index([clientId])
  @@index([createdByUserId])
  @@map("message_threads")
}

model Message {
  id           String    @id @default(uuid())
  threadId     String
  senderUserId String
  content      String    @db.Text
  sentAt       DateTime  @default(now())
  readAt       DateTime?

  // Relations
  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderUserId], references: [id])

  @@index([threadId])
  @@index([senderUserId])
  @@map("messages")
}

// NEW CRM FEATURES

model Contact {
  id              String    @id @default(uuid())
  clientId        String
  leadId          String?
  firstName       String
  lastName        String
  email           String?
  phone           String?
  title           String?
  department      String?
  linkedinUrl     String?
  isPrimary       Boolean   @default(false)
  accountId       String?
  ownerId         String
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  client        ClientCompany @relation(fields: [clientId], references: [id], onDelete: Cascade)
  owner         User          @relation(fields: [ownerId], references: [id])
  account       Contact?      @relation("AccountHierarchy", fields: [accountId], references: [id])
  subContacts   Contact[]     @relation("AccountHierarchy")
  opportunities Opportunity[]
  tasks         Task[]
  events        Event[]

  @@index([clientId])
  @@index([ownerId])
  @@index([accountId])
  @@index([email])
  @@map("contacts")
}

model Opportunity {
  id              String            @id @default(uuid())
  clientId        String
  contactId       String?
  leadId          String?           @unique
  name            String
  stage           OpportunityStage  @default(PROSPECTING)
  amount          Float             @default(0)
  probability     Int               @default(0)
  expectedCloseDate DateTime?
  closedDate      DateTime?
  ownerId         String
  description     String?           @db.Text
  nextSteps       String?           @db.Text
  lostReason      String?
  competitorInfo  String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  client         ClientCompany  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contact        Contact?       @relation(fields: [contactId], references: [id])
  lead           Lead?          @relation(fields: [leadId], references: [id])
  owner          User           @relation(fields: [ownerId], references: [id])
  lineItems      OpportunityLineItem[]
  tasks          Task[]
  events         Event[]

  @@index([clientId])
  @@index([contactId])
  @@index([ownerId])
  @@index([stage])
  @@index([expectedCloseDate])
  @@map("opportunities")
}

model OpportunityLineItem {
  id             String   @id @default(uuid())
  opportunityId  String
  productId      String?
  productName    String
  quantity       Int      @default(1)
  unitPrice      Float
  discount       Float    @default(0)
  totalPrice     Float
  description    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id])

  @@index([opportunityId])
  @@index([productId])
  @@map("opportunity_line_items")
}

model Task {
  id          String       @id @default(uuid())
  subject     String
  description String?      @db.Text
  dueDate     DateTime?
  status      TaskStatus   @default(NOT_STARTED)
  priority    TaskPriority @default(MEDIUM)
  assignedTo  String
  createdBy   String
  contactId   String?
  opportunityId String?
  relatedTo   String?
  reminderDate DateTime?
  completedDate DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  assignee    User         @relation("AssignedTasks", fields: [assignedTo], references: [id])
  creator     User         @relation("CreatedTasks", fields: [createdBy], references: [id])
  contact     Contact?     @relation(fields: [contactId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])

  @@index([assignedTo])
  @@index([createdBy])
  @@index([contactId])
  @@index([opportunityId])
  @@index([dueDate])
  @@index([status])
  @@map("tasks")
}

model Event {
  id            String    @id @default(uuid())
  subject       String
  description   String?   @db.Text
  startTime     DateTime
  endTime       DateTime
  location      String?
  isAllDay      Boolean   @default(false)
  ownerId       String
  contactId     String?
  opportunityId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  owner       User         @relation(fields: [ownerId], references: [id])
  contact     Contact?     @relation(fields: [contactId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])

  @@index([ownerId])
  @@index([contactId])
  @@index([opportunityId])
  @@index([startTime])
  @@map("events")
}

model EmailTemplate {
  id          String   @id @default(uuid())
  name        String
  subject     String
  body        String   @db.Text
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("email_templates")
}

model Email {
  id          String      @id @default(uuid())
  senderId    String
  toAddress   String
  ccAddress   String?
  bccAddress  String?
  subject     String
  body        String      @db.Text
  status      EmailStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?
  bouncedAt   DateTime?
  trackingId  String?     @unique
  templateId  String?
  contactId   String?
  opportunityId String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  sender User @relation(fields: [senderId], references: [id])

  @@index([senderId])
  @@index([contactId])
  @@index([opportunityId])
  @@index([status])
  @@index([sentAt])
  @@map("emails")
}

model Product {
  id          String   @id @default(uuid())
  clientId    String
  name        String
  code        String?
  description String?  @db.Text
  unitPrice   Float
  isActive    Boolean  @default(true)
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  client    ClientCompany         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lineItems OpportunityLineItem[]

  @@index([clientId])
  @@index([isActive])
  @@map("products")
}

model Territory {
  id          String   @id @default(uuid())
  clientId    String
  name        String
  description String?  @db.Text
  regions     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  client ClientCompany @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([isActive])
  @@map("territories")
}

model WorkflowRule {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  objectType  String
  triggerType String
  conditions  Json
  actions     Json
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([objectType])
  @@index([isActive])
  @@map("workflow_rules")
}

model Quota {
  id          String   @id @default(uuid())
  userId      String
  period      String
  target      Float
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([period])
  @@map("quotas")
}

// Notes - Can be attached to Contacts, Leads, Opportunities
model Note {
  id            String   @id @default(uuid())
  content       String   @db.Text
  createdBy     String
  contactId     String?
  leadId        String?
  opportunityId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  creator User @relation("CreatedNotes", fields: [createdBy], references: [id])

  @@index([contactId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([createdBy])
  @@index([createdAt])
  @@map("notes")
}

// File Attachments - Can be attached to any record
model Attachment {
  id            String   @id @default(uuid())
  fileName      String
  fileSize      Int
  fileType      String
  fileData      Bytes    // Store file data directly in database
  uploadedBy    String
  contactId     String?
  leadId        String?
  opportunityId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  uploader User @relation("UploadedAttachments", fields: [uploadedBy], references: [id])

  @@index([contactId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([uploadedBy])
  @@map("attachments")
}

// Opportunity Contact Roles - Multiple contacts per opportunity with roles
enum ContactRole {
  DECISION_MAKER
  INFLUENCER
  ECONOMIC_BUYER
  TECHNICAL_BUYER
  CHAMPION
  EVALUATOR
  END_USER
}

model OpportunityContactRole {
  id            String      @id @default(uuid())
  opportunityId String
  contactId     String
  role          ContactRole
  isPrimary     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([opportunityId, contactId])
  @@index([opportunityId])
  @@index([contactId])
  @@map("opportunity_contact_roles")
}

// Lead Scoring - Track score history and trending
enum ScoreCategory {
  DEMOGRAPHIC
  BEHAVIORAL
  ENGAGEMENT
  FIRMOGRAPHIC
}

model LeadScore {
  id            String        @id @default(uuid())
  leadId        String
  score         Int
  category      ScoreCategory
  reason        String?
  factors       Json?
  calculatedAt  DateTime      @default(now())

  @@index([leadId])
  @@index([calculatedAt])
  @@map("lead_scores")
}

// Field History / Audit Trail - Track all field changes across all objects
model FieldHistory {
  id            String   @id @default(uuid())
  objectType    String   // Lead, Contact, Opportunity, etc.
  objectId      String   // ID of the record that changed
  fieldName     String   // Name of the field that changed
  oldValue      String?  @db.Text // Previous value (as string)
  newValue      String?  @db.Text // New value (as string)
  changedBy     String   // User who made the change
  changedAt     DateTime @default(now())

  @@index([objectType, objectId])
  @@index([changedBy])
  @@index([changedAt])
  @@map("field_history")
}

// Lead Assignment Rules - Auto-assign leads based on criteria
enum AssignmentMethod {
  ROUND_ROBIN
  LOAD_BALANCED
  TERRITORY
  MANUAL
}

model LeadAssignmentRule {
  id              String           @id @default(uuid())
  name            String
  description     String?          @db.Text
  criteria        Json             // Conditions for assignment
  assignmentMethod AssignmentMethod @default(ROUND_ROBIN)
  assignToUserIds String[]         // List of user IDs to assign to
  territoryId     String?          // Territory for territory-based assignment
  isActive        Boolean          @default(true)
  priority        Int              @default(0) // Higher priority rules run first
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([isActive])
  @@index([priority])
  @@map("lead_assignment_rules")
}

// Notifications System
enum NotificationType {
  LEAD_ASSIGNED
  TASK_ASSIGNED
  OPPORTUNITY_WON
  OPPORTUNITY_LOST
  EMAIL_RECEIVED
  MENTION
  COMMENT
  WORKFLOW_TRIGGERED
  SYSTEM
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  type        NotificationType
  title       String
  message     String           @db.Text
  link        String?          // URL to navigate to when clicked
  isRead      Boolean          @default(false)
  metadata    Json?            // Additional data
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// Process Builder - Visual Workflows
model ProcessFlow {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  objectType  String   // Lead, Contact, Opportunity, etc.
  nodes       Json     // Visual flow nodes (triggers, conditions, actions)
  edges       Json     // Connections between nodes
  isActive    Boolean  @default(false)
  version     Int      @default(1)
  createdBy   String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  creator User @relation("CreatedProcessFlows", fields: [createdBy], references: [id])
  executions ProcessFlowExecution[]

  @@index([objectType])
  @@index([isActive])
  @@index([createdBy])
  @@map("process_flows")
}

// Track execution of process flows
model ProcessFlowExecution {
  id            String   @id @default(uuid())
  processFlowId String
  objectId      String   // ID of the record that triggered the flow
  status        String   // success, failed, running
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  error         String?  @db.Text
  executionLog  Json     // Log of each step executed

  processFlow ProcessFlow @relation(fields: [processFlowId], references: [id], onDelete: Cascade)

  @@index([processFlowId])
  @@index([status])
  @@index([startedAt])
  @@map("process_flow_executions")
}

// Einstein AI - Predictions & Forecasts
model AIPrediction {
  id             String   @id @default(uuid())
  predictionType String   // lead_score, deal_forecast, churn_risk, etc.
  objectType     String   // Lead, Opportunity, Contact
  objectId       String
  prediction     Json     // Prediction data (score, probability, recommendations)
  confidence     Float    // 0-100%
  reasoning      String?  @db.Text  // AI explanation
  modelVersion   String   @default("1.0")
  createdAt      DateTime @default(now())
  expiresAt      DateTime? // When prediction becomes stale

  @@index([objectType, objectId])
  @@index([predictionType])
  @@index([createdAt])
  @@map("ai_predictions")
}

// Revenue Forecasting
model RevenueForecast {
  id           String   @id @default(uuid())
  period       String   // 2024-Q1, 2024-12, etc.
  forecastType String   // monthly, quarterly, yearly
  predictedAmount Float
  actualAmount Float?
  confidence   Float
  breakdown    Json     // By rep, by stage, by product
  generatedBy  String   // AI or manual
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([period])
  @@index([forecastType])
  @@map("revenue_forecasts")
}

// AI Insights & Recommendations
model AIInsight {
  id          String   @id @default(uuid())
  insightType String   // opportunity_at_risk, best_time_to_contact, upsell_opportunity, etc.
  title       String
  description String   @db.Text
  objectType  String   // Lead, Opportunity, Contact, Deal
  objectId    String
  priority    String   // high, medium, low
  actionItems Json     // Recommended actions
  dismissed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  expiresAt   DateTime? // When insight becomes irrelevant

  @@index([objectType, objectId])
  @@index([insightType])
  @@index([priority, dismissed])
  @@index([createdAt])
  @@map("ai_insights")
}

