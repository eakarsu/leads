// This is your Prisma schema file for LeadGenFlow AI
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ACCOUNT_MANAGER
  CAMPAIGN_SPECIALIST
  CLIENT
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum CampaignChannel {
  EMAIL
  LINKEDIN
  COLD_CALL
  PAID_ADS
  MULTI_CHANNEL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  WON
  LOST
}

enum ActivityType {
  EMAIL
  CALL
  LINKEDIN
  MEETING
  NOTE
}

enum BusinessSector {
  HOME_SERVICES
  LEGAL_SERVICES
  FINANCIAL_SERVICES
  REAL_ESTATE
  HEALTHCARE
  B2B_SAAS
  EDUCATION
  AUTOMOTIVE
  HOSPITALITY
  FITNESS_WELLNESS
  CONSTRUCTION
  ECOMMERCE
  INSURANCE
  SOLAR_ENERGY
  GENERAL
}

enum OpportunityStage {
  PROSPECTING
  QUALIFICATION
  NEEDS_ANALYSIS
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DEFERRED
  WAITING
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EmailStatus {
  DRAFT
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  hashedPassword  String
  name            String
  role            UserRole  @default(CLIENT)
  clientId        String?
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  client                  ClientCompany?           @relation(fields: [clientId], references: [id])
  ownedCampaigns          Campaign[]
  activities              LeadActivity[]
  createdThreads          MessageThread[]
  sentMessages            Message[]
  submittedLeads          Lead[]
  ownedOpportunities      Opportunity[]
  assignedTasks           Task[]                   @relation("AssignedTasks")
  createdTasks            Task[]                   @relation("CreatedTasks")
  events                  Event[]
  sentEmails              Email[]
  contacts                Contact[]
  createdNotes            Note[]                   @relation("CreatedNotes")
  uploadedAttachments     Attachment[]             @relation("UploadedAttachments")
  notifications           Notification[]
  createdProcessFlows     ProcessFlow[]            @relation("CreatedProcessFlows")
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([clientId])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("email_verification_tokens")
}

model ClientCompany {
  id             String         @id @default(uuid())
  name           String
  industry       String
  businessSector BusinessSector @default(GENERAL)
  website        String?
  contactName    String
  contactEmail   String
  contactPhone   String?
  notes          String?        @db.Text
  isPartner      Boolean        @default(false)
  partnerLevel   String? // BRONZE, SILVER, GOLD, PLATINUM
  type           String? // Customer, Partner, Prospect
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  users            User[]
  campaigns        Campaign[]
  leads            Lead[]
  reports          ReportSnapshot[]
  messageThreads   MessageThread[]
  opportunities    Opportunity[]
  contacts         Contact[]
  territories      Territory[]
  products         Product[]
  serviceContracts ServiceContract[] @relation("ServiceContracts")
  workOrders       WorkOrder[]

  @@map("client_companies")
}

model Campaign {
  id            String          @id @default(uuid())
  clientId      String
  name          String
  description   String?         @db.Text
  status        CampaignStatus  @default(DRAFT)
  channel       CampaignChannel
  targetPersona String?         @db.Text
  targetRegions String?
  startDate     DateTime?
  endDate       DateTime?
  ownerId       String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  client  ClientCompany    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  owner   User             @relation(fields: [ownerId], references: [id])
  leads   Lead[]
  reports ReportSnapshot[]

  @@index([clientId])
  @@index([ownerId])
  @@index([status])
  @@map("campaigns")
}

enum LeadSource {
  AGENCY
  CLIENT_SUBMITTED
  IMPORTED
  API
  MANUAL
}

model Lead {
  id                 String     @id @default(uuid())
  campaignId         String?
  clientId           String
  fullName           String
  company            String?
  title              String?
  email              String?
  phone              String?
  linkedinUrl        String?
  website            String?
  source             String?
  leadSource         LeadSource @default(AGENCY)
  submittedBy        String?
  status             LeadStatus @default(NEW)
  qualificationScore Int        @default(0)
  notes              String?    @db.Text
  customFields       Json?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Relations
  campaign             Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  client               ClientCompany    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  submitter            User?            @relation(fields: [submittedBy], references: [id])
  activities           LeadActivity[]
  enrichmentData       EnrichmentData[]
  convertedOpportunity Opportunity?

  @@index([campaignId])
  @@index([clientId])
  @@index([status])
  @@index([qualificationScore])
  @@index([leadSource])
  @@map("leads")
}

model LeadActivity {
  id        String       @id @default(uuid())
  leadId    String
  type      ActivityType
  timestamp DateTime     @default(now())
  userId    String
  content   String       @db.Text
  aiSummary String?      @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([userId])
  @@index([type])
  @@map("lead_activities")
}

model EnrichmentData {
  id          String   @id @default(uuid())
  leadId      String
  companySize String?
  industry    String?
  techStack   String?
  location    String?
  extra       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("enrichment_data")
}

model ReportSnapshot {
  id          String   @id @default(uuid())
  clientId    String
  campaignId  String?
  periodStart DateTime
  periodEnd   DateTime
  metrics     Json
  aiSummary   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  client   ClientCompany @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaign Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([campaignId])
  @@map("report_snapshots")
}

model MessageThread {
  id              String   @id @default(uuid())
  clientId        String
  subject         String
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  client    ClientCompany @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User          @relation(fields: [createdByUserId], references: [id])
  messages  Message[]

  @@index([clientId])
  @@index([createdByUserId])
  @@map("message_threads")
}

model Message {
  id           String    @id @default(uuid())
  threadId     String
  senderUserId String
  content      String    @db.Text
  sentAt       DateTime  @default(now())
  readAt       DateTime?

  // Relations
  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderUserId], references: [id])

  @@index([threadId])
  @@index([senderUserId])
  @@map("messages")
}

// NEW CRM FEATURES

model Contact {
  id            String   @id @default(uuid())
  clientId      String
  leadId        String?
  firstName     String
  lastName      String
  email         String?
  phone         String?
  title         String?
  department    String?
  linkedinUrl   String?
  isPrimary     Boolean  @default(false)
  accountId     String?
  ownerId       String
  notes         String?  @db.Text
  isPortalUser  Boolean  @default(false)
  isPartnerUser Boolean  @default(false)
  portalStatus  String? // ACTIVE, INACTIVE, DISABLED, PENDING
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  client        ClientCompany @relation(fields: [clientId], references: [id], onDelete: Cascade)
  owner         User          @relation(fields: [ownerId], references: [id])
  account       Contact?      @relation("AccountHierarchy", fields: [accountId], references: [id])
  subContacts   Contact[]     @relation("AccountHierarchy")
  opportunities Opportunity[]
  tasks         Task[]
  events        Event[]

  @@index([clientId])
  @@index([ownerId])
  @@index([accountId])
  @@index([email])
  @@map("contacts")
}

model Opportunity {
  id                String           @id @default(uuid())
  clientId          String
  contactId         String?
  leadId            String?          @unique
  name              String
  stage             OpportunityStage @default(PROSPECTING)
  amount            Float            @default(0)
  probability       Int              @default(0)
  expectedCloseDate DateTime?
  closedDate        DateTime?
  ownerId           String
  description       String?          @db.Text
  nextSteps         String?          @db.Text
  lostReason        String?
  competitorInfo    String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relations
  client    ClientCompany         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contact   Contact?              @relation(fields: [contactId], references: [id])
  lead      Lead?                 @relation(fields: [leadId], references: [id])
  owner     User                  @relation(fields: [ownerId], references: [id])
  lineItems OpportunityLineItem[]
  tasks     Task[]
  events    Event[]

  @@index([clientId])
  @@index([contactId])
  @@index([ownerId])
  @@index([stage])
  @@index([expectedCloseDate])
  @@map("opportunities")
}

model OpportunityLineItem {
  id            String   @id @default(uuid())
  opportunityId String
  productId     String?
  productName   String
  quantity      Int      @default(1)
  unitPrice     Float
  discount      Float    @default(0)
  totalPrice    Float
  description   String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id])

  @@index([opportunityId])
  @@index([productId])
  @@map("opportunity_line_items")
}

model Task {
  id            String       @id @default(uuid())
  subject       String
  description   String?      @db.Text
  dueDate       DateTime?
  status        TaskStatus   @default(NOT_STARTED)
  priority      TaskPriority @default(MEDIUM)
  assignedTo    String
  createdBy     String
  contactId     String?
  opportunityId String?
  relatedTo     String?
  reminderDate  DateTime?
  completedDate DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  assignee    User         @relation("AssignedTasks", fields: [assignedTo], references: [id])
  creator     User         @relation("CreatedTasks", fields: [createdBy], references: [id])
  contact     Contact?     @relation(fields: [contactId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])

  @@index([assignedTo])
  @@index([createdBy])
  @@index([contactId])
  @@index([opportunityId])
  @@index([dueDate])
  @@index([status])
  @@map("tasks")
}

model Event {
  id            String   @id @default(uuid())
  subject       String
  description   String?  @db.Text
  startTime     DateTime
  endTime       DateTime
  location      String?
  isAllDay      Boolean  @default(false)
  ownerId       String
  contactId     String?
  opportunityId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  owner       User         @relation(fields: [ownerId], references: [id])
  contact     Contact?     @relation(fields: [contactId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])

  @@index([ownerId])
  @@index([contactId])
  @@index([opportunityId])
  @@index([startTime])
  @@map("events")
}

model EmailTemplate {
  id        String   @id @default(uuid())
  name      String
  subject   String
  body      String   @db.Text
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

model Email {
  id            String      @id @default(uuid())
  senderId      String
  toAddress     String
  ccAddress     String?
  bccAddress    String?
  subject       String
  body          String      @db.Text
  status        EmailStatus @default(DRAFT)
  scheduledAt   DateTime?
  sentAt        DateTime?
  openedAt      DateTime?
  clickedAt     DateTime?
  bouncedAt     DateTime?
  trackingId    String?     @unique
  templateId    String?
  contactId     String?
  opportunityId String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  sender User @relation(fields: [senderId], references: [id])

  @@index([senderId])
  @@index([contactId])
  @@index([opportunityId])
  @@index([status])
  @@index([sentAt])
  @@map("emails")
}

model Product {
  id          String   @id @default(uuid())
  clientId    String
  name        String
  code        String?
  description String?  @db.Text
  unitPrice   Float
  isActive    Boolean  @default(true)
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  client    ClientCompany         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lineItems OpportunityLineItem[]

  @@index([clientId])
  @@index([isActive])
  @@map("products")
}

model Territory {
  id          String   @id @default(uuid())
  clientId    String
  name        String
  description String?  @db.Text
  regions     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  client ClientCompany @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([isActive])
  @@map("territories")
}

model WorkflowRule {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  objectType  String
  triggerType String
  conditions  Json
  actions     Json
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([objectType])
  @@index([isActive])
  @@map("workflow_rules")
}

model Quota {
  id        String   @id @default(uuid())
  userId    String
  period    String
  target    Float
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([period])
  @@map("quotas")
}

// Notes - Can be attached to Contacts, Leads, Opportunities
model Note {
  id            String   @id @default(uuid())
  content       String   @db.Text
  createdBy     String
  contactId     String?
  leadId        String?
  opportunityId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  creator User @relation("CreatedNotes", fields: [createdBy], references: [id])

  @@index([contactId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([createdBy])
  @@index([createdAt])
  @@map("notes")
}

// File Attachments - Can be attached to any record
model Attachment {
  id            String   @id @default(uuid())
  fileName      String
  fileSize      Int
  fileType      String
  fileData      Bytes // Store file data directly in database
  uploadedBy    String
  contactId     String?
  leadId        String?
  opportunityId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  uploader User @relation("UploadedAttachments", fields: [uploadedBy], references: [id])

  @@index([contactId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([uploadedBy])
  @@map("attachments")
}

// Opportunity Contact Roles - Multiple contacts per opportunity with roles
enum ContactRole {
  DECISION_MAKER
  INFLUENCER
  ECONOMIC_BUYER
  TECHNICAL_BUYER
  CHAMPION
  EVALUATOR
  END_USER
}

model OpportunityContactRole {
  id            String      @id @default(uuid())
  opportunityId String
  contactId     String
  role          ContactRole
  isPrimary     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([opportunityId, contactId])
  @@index([opportunityId])
  @@index([contactId])
  @@map("opportunity_contact_roles")
}

// Lead Scoring - Track score history and trending
enum ScoreCategory {
  DEMOGRAPHIC
  BEHAVIORAL
  ENGAGEMENT
  FIRMOGRAPHIC
}

model LeadScore {
  id           String        @id @default(uuid())
  leadId       String
  score        Int
  category     ScoreCategory
  reason       String?
  factors      Json?
  calculatedAt DateTime      @default(now())

  @@index([leadId])
  @@index([calculatedAt])
  @@map("lead_scores")
}

// Field History / Audit Trail - Track all field changes across all objects
model FieldHistory {
  id         String   @id @default(uuid())
  objectType String // Lead, Contact, Opportunity, etc.
  objectId   String // ID of the record that changed
  fieldName  String // Name of the field that changed
  oldValue   String?  @db.Text // Previous value (as string)
  newValue   String?  @db.Text // New value (as string)
  changedBy  String // User who made the change
  changedAt  DateTime @default(now())

  @@index([objectType, objectId])
  @@index([changedBy])
  @@index([changedAt])
  @@map("field_history")
}

// Lead Assignment Rules - Auto-assign leads based on criteria
enum AssignmentMethod {
  ROUND_ROBIN
  LOAD_BALANCED
  TERRITORY
  MANUAL
}

model LeadAssignmentRule {
  id               String           @id @default(uuid())
  name             String
  description      String?          @db.Text
  criteria         Json // Conditions for assignment
  assignmentMethod AssignmentMethod @default(ROUND_ROBIN)
  assignToUserIds  String[] // List of user IDs to assign to
  territoryId      String? // Territory for territory-based assignment
  isActive         Boolean          @default(true)
  priority         Int              @default(0) // Higher priority rules run first
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([isActive])
  @@index([priority])
  @@map("lead_assignment_rules")
}

// Notifications System
enum NotificationType {
  LEAD_ASSIGNED
  TASK_ASSIGNED
  OPPORTUNITY_WON
  OPPORTUNITY_LOST
  EMAIL_RECEIVED
  MENTION
  COMMENT
  WORKFLOW_TRIGGERED
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  link      String? // URL to navigate to when clicked
  isRead    Boolean          @default(false)
  metadata  Json? // Additional data
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// Process Builder - Visual Workflows
model ProcessFlow {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  objectType  String // Lead, Contact, Opportunity, etc.
  nodes       Json // Visual flow nodes (triggers, conditions, actions)
  edges       Json // Connections between nodes
  isActive    Boolean  @default(false)
  version     Int      @default(1)
  createdBy   String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  creator    User                   @relation("CreatedProcessFlows", fields: [createdBy], references: [id])
  executions ProcessFlowExecution[]

  @@index([objectType])
  @@index([isActive])
  @@index([createdBy])
  @@map("process_flows")
}

// Track execution of process flows
model ProcessFlowExecution {
  id            String    @id @default(uuid())
  processFlowId String
  objectId      String // ID of the record that triggered the flow
  status        String // success, failed, running
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  error         String?   @db.Text
  executionLog  Json // Log of each step executed

  processFlow ProcessFlow @relation(fields: [processFlowId], references: [id], onDelete: Cascade)

  @@index([processFlowId])
  @@index([status])
  @@index([startedAt])
  @@map("process_flow_executions")
}

// Einstein AI - Predictions & Forecasts
model AIPrediction {
  id             String    @id @default(uuid())
  predictionType String // lead_score, deal_forecast, churn_risk, etc.
  objectType     String // Lead, Opportunity, Contact
  objectId       String
  prediction     Json // Prediction data (score, probability, recommendations)
  confidence     Float // 0-100%
  reasoning      String?   @db.Text // AI explanation
  modelVersion   String    @default("1.0")
  createdAt      DateTime  @default(now())
  expiresAt      DateTime? // When prediction becomes stale

  @@index([objectType, objectId])
  @@index([predictionType])
  @@index([createdAt])
  @@map("ai_predictions")
}

// Revenue Forecasting
model RevenueForecast {
  id              String   @id @default(uuid())
  period          String // 2024-Q1, 2024-12, etc.
  forecastType    String // monthly, quarterly, yearly
  predictedAmount Float
  actualAmount    Float?
  confidence      Float
  breakdown       Json // By rep, by stage, by product
  generatedBy     String // AI or manual
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([period])
  @@index([forecastType])
  @@map("revenue_forecasts")
}

// AI Insights & Recommendations
model AIInsight {
  id          String    @id @default(uuid())
  insightType String // opportunity_at_risk, best_time_to_contact, upsell_opportunity, etc.
  title       String
  description String    @db.Text
  objectType  String // Lead, Opportunity, Contact, Deal
  objectId    String
  priority    String // high, medium, low
  actionItems Json // Recommended actions
  dismissed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime? // When insight becomes irrelevant

  @@index([objectType, objectId])
  @@index([insightType])
  @@index([priority, dismissed])
  @@index([createdAt])
  @@map("ai_insights")
}

/// Generic AI invocation log — JSONB input + output for any AI feature.
/// Used by activity-capture, conversational agent, ensemble forecasts,
/// playbook generator, field lineage explainer, and the global /ai/results UI.
model AIResult {
  id           String   @id @default(uuid())
  feature      String
  userId       String?
  objectType   String?
  objectId     String?
  input        Json
  output       Json
  model        String?
  tokensUsed   Int?
  durationMs   Int?
  status       String   @default("success") // success | error
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([feature, createdAt])
  @@index([userId, createdAt])
  @@index([objectType, objectId])
  @@map("ai_results")
}

// ============================================
// NEW SALESFORCE FEATURES
// ============================================

// CASES / SERVICE CLOUD
enum CaseStatus {
  NEW
  OPEN
  IN_PROGRESS
  ESCALATED
  ON_HOLD
  WAITING_ON_CUSTOMER
  CLOSED
  RESOLVED
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CaseOrigin {
  PHONE
  EMAIL
  WEB
  CHAT
  SOCIAL
  PARTNER
}

model Case {
  id               String       @id @default(uuid())
  caseNumber       String       @unique @default(uuid())
  subject          String
  description      String?      @db.Text
  status           CaseStatus   @default(NEW)
  priority         CasePriority @default(MEDIUM)
  origin           CaseOrigin   @default(WEB)
  type             String? // Bug, Feature Request, Question, etc.
  reason           String? // Installation, User Education, etc.
  contactId        String?
  accountId        String?
  ownerId          String
  queueId          String?
  parentCaseId     String? // For case hierarchies
  escalatedAt      DateTime?
  closedAt         DateTime?
  resolution       String?      @db.Text
  internalComments String?      @db.Text
  slaDeadline      DateTime?
  firstResponseAt  DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  queue       CaseQueue?       @relation(fields: [queueId], references: [id])
  parentCase  Case?            @relation("CaseHierarchy", fields: [parentCaseId], references: [id])
  childCases  Case[]           @relation("CaseHierarchy")
  comments    CaseComment[]
  escalations CaseEscalation[]

  @@index([status])
  @@index([priority])
  @@index([ownerId])
  @@index([queueId])
  @@index([contactId])
  @@index([accountId])
  @@index([createdAt])
  @@map("cases")
}

model CaseComment {
  id        String   @id @default(uuid())
  caseId    String
  body      String   @db.Text
  isPublic  Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("case_comments")
}

model CaseQueue {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  memberIds   String[] // User IDs who can access this queue
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cases Case[]

  @@map("case_queues")
}

model CaseEscalation {
  id              String    @id @default(uuid())
  caseId          String
  escalatedTo     String // User ID
  escalatedBy     String // User ID
  reason          String    @db.Text
  escalatedAt     DateTime  @default(now())
  resolvedAt      DateTime?
  resolutionNotes String?   @db.Text

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("case_escalations")
}

model SLA {
  id                   String       @id @default(uuid())
  name                 String
  description          String?      @db.Text
  priority             CasePriority
  firstResponseMinutes Int // SLA for first response
  resolutionMinutes    Int // SLA for resolution
  businessHoursOnly    Boolean      @default(true)
  isActive             Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@map("slas")
}

// KNOWLEDGE BASE
enum ArticleStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

model KnowledgeCategory {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   KnowledgeCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children KnowledgeCategory[] @relation("CategoryHierarchy")
  articles KnowledgeArticle[]

  @@index([parentId])
  @@map("knowledge_categories")
}

model KnowledgeArticle {
  id              String        @id @default(uuid())
  articleNumber   String        @unique @default(uuid())
  title           String
  summary         String?       @db.Text
  content         String        @db.Text
  status          ArticleStatus @default(DRAFT)
  categoryId      String?
  authorId        String
  version         Int           @default(1)
  viewCount       Int           @default(0)
  helpfulCount    Int           @default(0)
  notHelpfulCount Int           @default(0)
  keywords        String[]
  isPublic        Boolean       @default(false) // Visible to customers
  publishedAt     DateTime?
  archivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category    KnowledgeCategory?  @relation(fields: [categoryId], references: [id])
  versions    ArticleVersion[]
  attachments ArticleAttachment[]

  @@index([status])
  @@index([categoryId])
  @@index([authorId])
  @@index([isPublic])
  @@map("knowledge_articles")
}

model ArticleVersion {
  id          String   @id @default(uuid())
  articleId   String
  version     Int
  title       String
  content     String   @db.Text
  changedBy   String
  changeNotes String?  @db.Text
  createdAt   DateTime @default(now())

  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@map("article_versions")
}

model ArticleAttachment {
  id        String   @id @default(uuid())
  articleId String
  fileName  String
  fileSize  Int
  fileType  String
  fileUrl   String
  createdAt DateTime @default(now())

  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@map("article_attachments")
}

// CONTRACTS
enum ContractStatus {
  DRAFT
  IN_APPROVAL
  ACTIVATED
  EXPIRED
  TERMINATED
}

model Contract {
  id                    String         @id @default(uuid())
  contractNumber        String         @unique @default(uuid())
  accountId             String
  name                  String
  status                ContractStatus @default(DRAFT)
  startDate             DateTime
  endDate               DateTime
  contractTerm          Int // Months
  ownerExpirationNotice Int? // Days before expiration to notify
  description           String?        @db.Text
  specialTerms          String?        @db.Text
  totalValue            Float          @default(0)
  ownerId               String
  signedDate            DateTime?
  companySignedBy       String?
  customerSignedBy      String?
  billingStreet         String?
  billingCity           String?
  billingState          String?
  billingPostalCode     String?
  billingCountry        String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  lineItems ContractLineItem[]
  renewals  ContractRenewal[]

  @@index([accountId])
  @@index([status])
  @@index([endDate])
  @@index([ownerId])
  @@map("contracts")
}

model ContractLineItem {
  id          String    @id @default(uuid())
  contractId  String
  productId   String?
  productName String
  quantity    Int       @default(1)
  unitPrice   Float
  discount    Float     @default(0)
  totalPrice  Float
  startDate   DateTime?
  endDate     DateTime?
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_line_items")
}

model ContractRenewal {
  id            String   @id @default(uuid())
  contractId    String
  renewalDate   DateTime
  renewalAmount Float
  renewalTerm   Int // Months
  status        String // Pending, Approved, Declined
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_renewals")
}

// QUOTES
enum QuoteStatus {
  DRAFT
  NEEDS_REVIEW
  IN_REVIEW
  APPROVED
  REJECTED
  PRESENTED
  ACCEPTED
  DENIED
}

model Quote {
  id                 String      @id @default(uuid())
  quoteNumber        String      @unique @default(uuid())
  name               String
  opportunityId      String?
  accountId          String
  contactId          String?
  status             QuoteStatus @default(DRAFT)
  expirationDate     DateTime
  subtotal           Float       @default(0)
  discount           Float       @default(0)
  discountType       String      @default("AMOUNT") // AMOUNT or PERCENT
  tax                Float       @default(0)
  shippingHandling   Float       @default(0)
  grandTotal         Float       @default(0)
  description        String?     @db.Text
  terms              String?     @db.Text
  ownerId            String
  isPrimary          Boolean     @default(false)
  pdfUrl             String?
  signatureUrl       String?
  signedAt           DateTime?
  signedBy           String?
  billingName        String?
  billingStreet      String?
  billingCity        String?
  billingState       String?
  billingPostalCode  String?
  billingCountry     String?
  shippingName       String?
  shippingStreet     String?
  shippingCity       String?
  shippingState      String?
  shippingPostalCode String?
  shippingCountry    String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  lineItems QuoteLineItem[]

  @@index([opportunityId])
  @@index([accountId])
  @@index([status])
  @@index([ownerId])
  @@map("quotes")
}

model QuoteLineItem {
  id          String   @id @default(uuid())
  quoteId     String
  productId   String?
  productName String
  productCode String?
  quantity    Int      @default(1)
  listPrice   Float
  unitPrice   Float
  discount    Float    @default(0)
  totalPrice  Float
  sortOrder   Int      @default(0)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_line_items")
}

// PRICE BOOKS
model PriceBook {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  isStandard  Boolean  @default(false) // Default price book
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries PriceBookEntry[]

  @@map("price_books")
}

model PriceBookEntry {
  id               String   @id @default(uuid())
  priceBookId      String
  productId        String
  unitPrice        Float
  isActive         Boolean  @default(true)
  useStandardPrice Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  priceBook PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)

  @@unique([priceBookId, productId])
  @@index([productId])
  @@map("price_book_entries")
}

// APPROVAL PROCESSES
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RECALLED
}

model ApprovalProcess {
  id            String   @id @default(uuid())
  name          String
  description   String?  @db.Text
  objectType    String // Quote, Contract, Opportunity, etc.
  entryCriteria Json // Conditions for when approval is required
  isActive      Boolean  @default(true)
  allowRecall   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  steps     ApprovalStep[]
  instances ApprovalInstance[]

  @@index([objectType])
  @@map("approval_processes")
}

model ApprovalStep {
  id                String   @id @default(uuid())
  processId         String
  stepNumber        Int
  name              String
  description       String?  @db.Text
  approverType      String // USER, MANAGER, QUEUE, ROLE
  approverIds       String[] // User IDs or Role IDs
  unanimousApproval Boolean  @default(false) // All must approve vs any can approve
  rejectBehavior    String   @default("FINAL") // FINAL or BACK_TO_PREVIOUS
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  process ApprovalProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@map("approval_steps")
}

model ApprovalInstance {
  id          String         @id @default(uuid())
  processId   String
  objectType  String
  objectId    String
  status      ApprovalStatus @default(PENDING)
  currentStep Int            @default(1)
  submittedBy String
  submittedAt DateTime       @default(now())
  completedAt DateTime?
  comments    String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  process ApprovalProcess  @relation(fields: [processId], references: [id])
  actions ApprovalAction[]

  @@index([processId])
  @@index([objectType, objectId])
  @@index([status])
  @@map("approval_instances")
}

model ApprovalAction {
  id         String         @id @default(uuid())
  instanceId String
  stepNumber Int
  actorId    String // User who took action
  action     ApprovalStatus // APPROVED, REJECTED, RECALLED
  comments   String?        @db.Text
  actionAt   DateTime       @default(now())

  instance ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@map("approval_actions")
}

// DUPLICATE MANAGEMENT
model DuplicateRule {
  id             String   @id @default(uuid())
  name           String
  description    String?  @db.Text
  objectType     String // Lead, Contact, Account
  matchCriteria  Json // Fields to compare and match logic
  isActive       Boolean  @default(true)
  actionOnCreate String   @default("ALERT") // ALERT, BLOCK, ALLOW
  actionOnEdit   String   @default("ALERT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([objectType])
  @@map("duplicate_rules")
}

model DuplicateRecordSet {
  id             String   @id @default(uuid())
  objectType     String
  recordIds      String[] // IDs of duplicate records
  masterRecordId String? // The record chosen as master after merge
  status         String   @default("PENDING") // PENDING, MERGED, IGNORED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([objectType])
  @@index([status])
  @@map("duplicate_record_sets")
}

// DATA IMPORT
enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIALLY_COMPLETED
}

model DataImport {
  id                String       @id @default(uuid())
  name              String
  objectType        String // Lead, Contact, Account
  fileName          String
  fileSize          Int
  status            ImportStatus @default(PENDING)
  totalRows         Int          @default(0)
  processedRows     Int          @default(0)
  successRows       Int          @default(0)
  failedRows        Int          @default(0)
  duplicateRows     Int          @default(0)
  fieldMapping      Json // CSV column to object field mapping
  duplicateHandling String       @default("SKIP") // SKIP, UPDATE, CREATE_NEW
  ownerId           String
  startedAt         DateTime?
  completedAt       DateTime?
  errorLog          Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([objectType])
  @@index([status])
  @@index([ownerId])
  @@map("data_imports")
}

// MASS EMAIL
model MassEmailJob {
  id              String    @id @default(uuid())
  name            String
  templateId      String?
  subject         String
  body            String    @db.Text
  recipientType   String // Lead, Contact
  recipientIds    String[] // Specific IDs or filter criteria
  filterCriteria  Json? // Dynamic filter for recipients
  status          String    @default("DRAFT") // DRAFT, SCHEDULED, SENDING, COMPLETED, FAILED
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  totalRecipients Int       @default(0)
  sentCount       Int       @default(0)
  failedCount     Int       @default(0)
  openedCount     Int       @default(0)
  clickedCount    Int       @default(0)
  bouncedCount    Int       @default(0)
  ownerId         String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([ownerId])
  @@map("mass_email_jobs")
}

// WEB-TO-LEAD / WEB-TO-CASE
model WebForm {
  id              String   @id @default(uuid())
  name            String
  formType        String // LEAD, CASE
  description     String?  @db.Text
  fields          Json // Form field configuration
  defaultValues   Json? // Default field values
  redirectUrl     String? // URL to redirect after submission
  notifyEmails    String[] // Emails to notify on submission
  isActive        Boolean  @default(true)
  captchaEnabled  Boolean  @default(true)
  publicToken     String   @unique @default(uuid()) // Used in public URL
  submissionCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  submissions WebFormSubmission[]

  @@map("web_forms")
}

model WebFormSubmission {
  id           String   @id @default(uuid())
  formId       String
  data         Json // Submitted form data
  ipAddress    String?
  userAgent    String?
  recordId     String? // Created Lead or Case ID
  status       String   @default("PENDING") // PENDING, PROCESSED, FAILED
  errorMessage String?
  createdAt    DateTime @default(now())

  form WebForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([status])
  @@map("web_form_submissions")
}

// CHATTER / FEED
enum FeedItemType {
  TEXT_POST
  LINK_POST
  CONTENT_POST
  POLL
  STATUS_UPDATE
  RECORD_UPDATE
  ANNOUNCEMENT
}

model FeedItem {
  id           String       @id @default(uuid())
  type         FeedItemType @default(TEXT_POST)
  body         String       @db.Text
  parentId     String? // Record ID (Lead, Opportunity, etc.) or Group ID
  parentType   String? // Lead, Opportunity, Account, Group, User
  authorId     String
  linkUrl      String?
  linkTitle    String?
  isRichText   Boolean      @default(false)
  visibility   String       @default("ALL_USERS") // ALL_USERS, INTERNAL_ONLY
  likeCount    Int          @default(0)
  commentCount Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  comments FeedComment[]
  likes    FeedLike[]
  mentions FeedMention[]

  @@index([parentType, parentId])
  @@index([authorId])
  @@index([createdAt])
  @@map("feed_items")
}

model FeedComment {
  id         String   @id @default(uuid())
  feedItemId String
  body       String   @db.Text
  authorId   String
  likeCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  feedItem FeedItem      @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
  likes    FeedLike[]
  mentions FeedMention[]

  @@index([feedItemId])
  @@map("feed_comments")
}

model FeedLike {
  id         String   @id @default(uuid())
  userId     String
  feedItemId String?
  commentId  String?
  createdAt  DateTime @default(now())

  feedItem FeedItem?    @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
  comment  FeedComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, feedItemId])
  @@unique([userId, commentId])
  @@map("feed_likes")
}

model FeedMention {
  id         String   @id @default(uuid())
  userId     String // User being mentioned
  feedItemId String?
  commentId  String?
  createdAt  DateTime @default(now())

  feedItem FeedItem?    @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
  comment  FeedComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("feed_mentions")
}

model ChatterGroup {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  isArchived  Boolean  @default(false)
  isPublic    Boolean  @default(true)
  ownerId     String
  memberCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members GroupMember[]

  @@map("chatter_groups")
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String
  userId   String
  role     String   @default("MEMBER") // MEMBER, ADMIN
  joinedAt DateTime @default(now())

  group ChatterGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_members")
}

// PORTALS
model PortalUser {
  id             String    @id @default(uuid())
  email          String    @unique
  hashedPassword String
  firstName      String
  lastName       String
  portalType     String // PARTNER, CUSTOMER
  accountId      String? // Associated account/company
  contactId      String? // Associated contact record
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([portalType])
  @@index([accountId])
  @@map("portal_users")
}

model DealRegistration {
  id                String    @id @default(uuid())
  partnerUserId     String
  companyName       String
  contactName       String
  contactEmail      String
  contactPhone      String?
  dealDescription   String    @db.Text
  estimatedAmount   Float
  expectedCloseDate DateTime
  status            String    @default("PENDING") // PENDING, APPROVED, REJECTED, CONVERTED
  opportunityId     String? // Created opportunity ID
  reviewedBy        String?
  reviewedAt        DateTime?
  reviewNotes       String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([partnerUserId])
  @@index([status])
  @@map("deal_registrations")
}

// CUSTOM OBJECTS
model CustomObject {
  id          String   @id @default(uuid())
  name        String   @unique
  label       String
  pluralLabel String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields  CustomField[]
  records CustomRecord[]
  layouts PageLayout[]

  @@map("custom_objects")
}

model CustomField {
  id                String   @id @default(uuid())
  objectId          String
  name              String
  label             String
  type              String // TEXT, NUMBER, DATE, DATETIME, BOOLEAN, PICKLIST, LOOKUP, FORMULA
  isRequired        Boolean  @default(false)
  isUnique          Boolean  @default(false)
  defaultValue      String?
  helpText          String?
  picklistValues    String[] // For picklist fields
  lookupObjectId    String? // For lookup fields
  formulaExpression String? // For formula fields
  maxLength         Int?
  decimalPlaces     Int?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  object CustomObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([objectId, name])
  @@index([objectId])
  @@map("custom_fields")
}

model CustomRecord {
  id        String   @id @default(uuid())
  objectId  String
  data      Json // Field values
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  object CustomObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([objectId])
  @@index([ownerId])
  @@map("custom_records")
}

// PAGE LAYOUTS
model PageLayout {
  id             String   @id @default(uuid())
  name           String
  objectType     String // Lead, Contact, Opportunity, or CustomObject ID
  customObjectId String?
  layoutConfig   Json // Sections, fields, related lists configuration
  isDefault      Boolean  @default(false)
  recordTypeId   String? // Associated record type
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customObject CustomObject? @relation(fields: [customObjectId], references: [id])

  @@index([objectType])
  @@map("page_layouts")
}

// RECORD TYPES
model RecordType {
  id          String   @id @default(uuid())
  name        String
  objectType  String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([objectType, name])
  @@map("record_types")
}

// SHARING RULES
model SharingRule {
  id             String   @id @default(uuid())
  name           String
  objectType     String
  description    String?  @db.Text
  sharedFrom     String // Role, Group, or User ID
  sharedFromType String // ROLE, PUBLIC_GROUP, USER
  sharedTo       String // Role, Group, or User ID
  sharedToType   String // ROLE, PUBLIC_GROUP, USER
  accessLevel    String // READ, EDIT
  criteria       Json? // Criteria-based sharing rules
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([objectType])
  @@map("sharing_rules")
}

// REPORTS BUILDER
enum ReportFormat {
  TABULAR
  SUMMARY
  MATRIX
}

model Report {
  id          String       @id @default(uuid())
  name        String
  description String?      @db.Text
  objectType  String // Primary object
  format      ReportFormat @default(TABULAR)
  columns     Json // Selected columns
  filters     Json? // Filter criteria
  groupBy     String[] // Grouping fields
  sortBy      Json? // Sort configuration
  chartConfig Json? // Chart visualization settings
  folderId    String?
  ownerId     String
  isPublic    Boolean      @default(false)
  lastRunAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  folder ReportFolder? @relation(fields: [folderId], references: [id])

  @@index([objectType])
  @@index([folderId])
  @@index([ownerId])
  @@map("reports")
}

model ReportFolder {
  id          String   @id @default(uuid())
  name        String
  parentId    String?
  accessLevel String   @default("PRIVATE") // PRIVATE, PUBLIC_READ, PUBLIC_EDIT
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   ReportFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children ReportFolder[] @relation("FolderHierarchy")
  reports  Report[]

  @@index([parentId])
  @@map("report_folders")
}

// CAMPAIGN INFLUENCE / ATTRIBUTION
model CampaignInfluence {
  id               String   @id @default(uuid())
  campaignId       String
  opportunityId    String
  contactId        String?
  influencePercent Float    @default(0)
  revenueShare     Float    @default(0)
  isPrimary        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([campaignId, opportunityId, contactId])
  @@index([campaignId])
  @@index([opportunityId])
  @@map("campaign_influences")
}

model TouchPoint {
  id         String   @id @default(uuid())
  campaignId String
  contactId  String
  leadId     String?
  touchType  String // EMAIL_OPEN, EMAIL_CLICK, WEB_VISIT, FORM_SUBMIT, EVENT_ATTENDANCE
  touchDate  DateTime @default(now())
  metadata   Json? // Additional data about the touch

  @@index([campaignId])
  @@index([contactId])
  @@index([leadId])
  @@index([touchDate])
  @@map("touch_points")
}

// ============================================
// FILES / DOCUMENT MANAGEMENT
// ============================================

model File {
  id            String   @id @default(uuid())
  name          String
  description   String?  @db.Text
  fileSize      Int
  fileType      String
  contentType   String // MIME type
  storageUrl    String // URL or path to file
  thumbnailUrl  String?
  isPublic      Boolean  @default(false)
  ownerId       String
  folderId      String?
  version       Int      @default(1)
  downloadCount Int      @default(0)
  tags          String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  folder   FileFolder?   @relation(fields: [folderId], references: [id])
  links    FileLink[]
  versions FileVersion[]

  @@index([ownerId])
  @@index([folderId])
  @@index([fileType])
  @@map("files")
}

model FileFolder {
  id        String   @id @default(uuid())
  name      String
  parentId  String?
  ownerId   String
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   FileFolder?  @relation("FileFolderHierarchy", fields: [parentId], references: [id])
  children FileFolder[] @relation("FileFolderHierarchy")
  files    File[]

  @@index([parentId])
  @@index([ownerId])
  @@map("file_folders")
}

model FileVersion {
  id          String   @id @default(uuid())
  fileId      String
  version     Int
  storageUrl  String
  fileSize    Int
  uploadedBy  String
  changeNotes String?  @db.Text
  createdAt   DateTime @default(now())

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@map("file_versions")
}

model FileLink {
  id           String   @id @default(uuid())
  fileId       String
  linkedToType String // Lead, Contact, Opportunity, Case, etc.
  linkedToId   String
  createdAt    DateTime @default(now())

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, linkedToType, linkedToId])
  @@index([linkedToType, linkedToId])
  @@map("file_links")
}

// ============================================
// CALENDAR
// ============================================

model CalendarEvent {
  id                String    @id @default(uuid())
  subject           String
  description       String?   @db.Text
  location          String?
  startDateTime     DateTime
  endDateTime       DateTime
  isAllDay          Boolean   @default(false)
  isPrivate         Boolean   @default(false)
  ownerId           String
  recurrenceRule    String? // iCal RRULE format
  recurrenceEndDate DateTime?
  parentEventId     String? // For recurring event instances
  reminderMinutes   Int?
  status            String    @default("CONFIRMED") // CONFIRMED, TENTATIVE, CANCELLED
  busyStatus        String    @default("BUSY") // FREE, BUSY, OUT_OF_OFFICE
  relatedToType     String? // Lead, Contact, Opportunity
  relatedToId       String?
  color             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  parentEvent CalendarEvent?  @relation("EventRecurrence", fields: [parentEventId], references: [id])
  childEvents CalendarEvent[] @relation("EventRecurrence")
  attendees   EventAttendee[]

  @@index([ownerId])
  @@index([startDateTime])
  @@index([parentEventId])
  @@index([relatedToType, relatedToId])
  @@map("calendar_events")
}

model EventAttendee {
  id          String    @id @default(uuid())
  eventId     String
  userId      String? // Internal user
  email       String // External or internal email
  name        String?
  status      String    @default("PENDING") // PENDING, ACCEPTED, DECLINED, TENTATIVE
  isRequired  Boolean   @default(true)
  isOrganizer Boolean   @default(false)
  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@map("event_attendees")
}

// ============================================
// ORDERS
// ============================================

enum OrderStatus {
  DRAFT
  ACTIVATED
  FULFILLED
  CANCELLED
}

model Order {
  id                 String      @id @default(uuid())
  orderNumber        String      @unique @default(uuid())
  accountId          String
  contactId          String?
  opportunityId      String?
  quoteId            String?
  contractId         String?
  status             OrderStatus @default(DRAFT)
  orderDate          DateTime    @default(now())
  effectiveDate      DateTime?
  endDate            DateTime?
  description        String?     @db.Text
  subtotal           Float       @default(0)
  discount           Float       @default(0)
  tax                Float       @default(0)
  shippingHandling   Float       @default(0)
  totalAmount        Float       @default(0)
  billingStreet      String?
  billingCity        String?
  billingState       String?
  billingPostalCode  String?
  billingCountry     String?
  shippingStreet     String?
  shippingCity       String?
  shippingState      String?
  shippingPostalCode String?
  shippingCountry    String?
  ownerId            String
  poNumber           String? // Purchase Order Number
  poDate             DateTime?
  activatedDate      DateTime?
  activatedBy        String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  lineItems OrderLineItem[]
  invoices  Invoice[]

  @@index([accountId])
  @@index([status])
  @@index([ownerId])
  @@index([orderDate])
  @@map("orders")
}

model OrderLineItem {
  id          String    @id @default(uuid())
  orderId     String
  productId   String?
  productName String
  productCode String?
  quantity    Int       @default(1)
  listPrice   Float
  unitPrice   Float
  discount    Float     @default(0)
  totalPrice  Float
  description String?   @db.Text
  startDate   DateTime?
  endDate     DateTime?
  serviceDate DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("order_line_items")
}

// ============================================
// INVOICES
// ============================================

enum InvoiceStatus {
  DRAFT
  PENDING
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
  VOID
}

model Invoice {
  id                String        @id @default(uuid())
  invoiceNumber     String        @unique @default(uuid())
  accountId         String
  contactId         String?
  orderId           String?
  status            InvoiceStatus @default(DRAFT)
  invoiceDate       DateTime      @default(now())
  dueDate           DateTime
  subtotal          Float         @default(0)
  discount          Float         @default(0)
  tax               Float         @default(0)
  totalAmount       Float         @default(0)
  amountPaid        Float         @default(0)
  balance           Float         @default(0)
  description       String?       @db.Text
  terms             String?       @db.Text
  notes             String?       @db.Text
  billingStreet     String?
  billingCity       String?
  billingState      String?
  billingPostalCode String?
  billingCountry    String?
  ownerId           String
  sentAt            DateTime?
  paidAt            DateTime?
  paymentMethod     String?
  paymentReference  String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order     Order?            @relation(fields: [orderId], references: [id])
  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@index([accountId])
  @@index([status])
  @@index([dueDate])
  @@index([ownerId])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String   @id @default(uuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Int      @default(1)
  unitPrice   Float
  discount    Float    @default(0)
  totalPrice  Float
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model Payment {
  id            String   @id @default(uuid())
  invoiceId     String
  amount        Float
  paymentDate   DateTime @default(now())
  paymentMethod String // CREDIT_CARD, BANK_TRANSFER, CHECK, CASH, OTHER
  reference     String? // Transaction ID or check number
  notes         String?  @db.Text
  createdAt     DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payments")
}

// ============================================
// ASSETS
// ============================================

enum AssetStatus {
  PURCHASED
  SHIPPED
  INSTALLED
  REGISTERED
  OBSOLETE
}

model Asset {
  id              String      @id @default(uuid())
  name            String
  serialNumber    String?
  description     String?     @db.Text
  status          AssetStatus @default(PURCHASED)
  accountId       String
  contactId       String?
  productId       String?
  productName     String?
  quantity        Int         @default(1)
  price           Float?
  purchaseDate    DateTime?
  installDate     DateTime?
  usageEndDate    DateTime?
  warrantyEndDate DateTime?
  parentAssetId   String? // For asset hierarchies
  rootAssetId     String? // Top-level asset
  ownerId         String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  parentAsset Asset?      @relation("AssetHierarchy", fields: [parentAssetId], references: [id])
  childAssets Asset[]     @relation("AssetHierarchy")
  cases       AssetCase[]

  @@index([accountId])
  @@index([status])
  @@index([serialNumber])
  @@index([productId])
  @@index([parentAssetId])
  @@map("assets")
}

model AssetCase {
  id        String   @id @default(uuid())
  assetId   String
  caseId    String
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, caseId])
  @@map("asset_cases")
}

// ============================================
// ENTITLEMENTS / SLA MANAGEMENT
// ============================================

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  INACTIVE
}

model Entitlement {
  id                  String            @id @default(uuid())
  name                String
  accountId           String
  assetId             String?
  contractId          String?
  status              EntitlementStatus @default(ACTIVE)
  startDate           DateTime
  endDate             DateTime
  slaProcessId        String?
  remainingCases      Int? // Number of cases remaining (-1 for unlimited)
  remainingWorkOrders Int? // Number of work orders remaining
  perIncident         Boolean           @default(false) // Per-incident entitlement
  description         String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  slaProcess EntitlementProcess? @relation(fields: [slaProcessId], references: [id])

  @@index([accountId])
  @@index([status])
  @@index([endDate])
  @@map("entitlements")
}

model EntitlementProcess {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entitlements Entitlement[]
  milestones   EntitlementMilestone[]

  @@map("entitlement_processes")
}

model EntitlementMilestone {
  id                String   @id @default(uuid())
  processId         String
  name              String
  description       String?  @db.Text
  recurrenceType    String // NO_RECURRENCE, INDEPENDENT, SEQUENTIAL
  minutesToComplete Int // Time to complete in minutes
  startCriteria     Json? // Criteria for when milestone starts
  successCriteria   Json? // Criteria for milestone completion
  violationActions  Json? // Actions when milestone is violated
  warningActions    Json? // Actions for warning before violation
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  process EntitlementProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@map("entitlement_milestones")
}

// ============================================
// ROLES & HIERARCHY
// ============================================

model Role {
  id                     String   @id @default(uuid())
  name                   String   @unique
  label                  String
  description            String?  @db.Text
  parentRoleId           String?
  allowForecast          Boolean  @default(false) // Can view forecast
  caseAccessLevel        String   @default("PRIVATE") // PRIVATE, READ_WRITE_TRANSFER, READ_ONLY
  opportunityAccessLevel String   @default("PRIVATE")
  contactAccessLevel     String   @default("CONTROLLED_BY_PARENT")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  parentRole Role?            @relation("RoleHierarchy", fields: [parentRoleId], references: [id])
  childRoles Role[]           @relation("RoleHierarchy")
  users      RoleAssignment[]

  @@index([parentRoleId])
  @@map("roles")
}

model RoleAssignment {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([roleId])
  @@map("role_assignments")
}

// ============================================
// PERMISSION SETS
// ============================================

model PermissionSet {
  id          String   @id @default(uuid())
  name        String   @unique
  label       String
  description String?  @db.Text
  isCustom    Boolean  @default(true)
  permissions Json // Object and field-level permissions
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments PermissionSetAssignment[]

  @@map("permission_sets")
}

model PermissionSetAssignment {
  id              String   @id @default(uuid())
  userId          String
  permissionSetId String
  createdAt       DateTime @default(now())

  permissionSet PermissionSet @relation(fields: [permissionSetId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionSetId])
  @@index([userId])
  @@map("permission_set_assignments")
}

// ============================================
// LIVE CHAT / OMNICHANNEL
// ============================================

enum ChatStatus {
  WAITING
  ACTIVE
  ENDED
  TRANSFERRED
}

model LiveChat {
  id            String     @id @default(uuid())
  visitorId     String? // Portal user or anonymous
  visitorName   String?
  visitorEmail  String?
  agentId       String? // Assigned agent
  status        ChatStatus @default(WAITING)
  channel       String     @default("WEB") // WEB, MOBILE, FACEBOOK, WHATSAPP
  startedAt     DateTime   @default(now())
  endedAt       DateTime?
  waitTime      Int? // Seconds waited before agent pickup
  duration      Int? // Chat duration in seconds
  caseId        String? // Created case ID
  transcript    String?    @db.Text
  rating        Int? // 1-5 customer rating
  ratingComment String?    @db.Text
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  messages LiveChatMessage[]

  @@index([agentId])
  @@index([status])
  @@index([startedAt])
  @@map("live_chats")
}

model LiveChatMessage {
  id          String   @id @default(uuid())
  chatId      String
  senderId    String? // null for system messages
  senderType  String // VISITOR, AGENT, SYSTEM, BOT
  content     String   @db.Text
  messageType String   @default("TEXT") // TEXT, FILE, IMAGE, LINK
  fileUrl     String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  chat LiveChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@map("live_chat_messages")
}

model OmnichannelPresence {
  id             String   @id @default(uuid())
  userId         String   @unique
  status         String   @default("OFFLINE") // ONLINE, AWAY, BUSY, OFFLINE
  capacity       Int      @default(5) // Max concurrent chats
  currentLoad    Int      @default(0) // Current active chats
  channels       String[] // WEB, PHONE, EMAIL, SOCIAL
  skills         String[] // Support skills for routing
  lastActivityAt DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("omnichannel_presence")
}

model RoutingQueue {
  id             String   @id @default(uuid())
  name           String
  description    String?  @db.Text
  channel        String // WEB, PHONE, EMAIL
  priority       Int      @default(0)
  routingType    String   @default("QUEUE") // QUEUE, SKILL_BASED, ROUND_ROBIN
  memberIds      String[] // Agent IDs
  requiredSkills String[]
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("routing_queues")
}

// ===========================================
// SERVICE CONTRACTS
// ===========================================

model ServiceContract {
  id             String   @id @default(uuid())
  contractNumber String   @unique
  name           String
  accountId      String
  contactId      String?
  status         String   @default("DRAFT") // DRAFT, ACTIVE, EXPIRED, CANCELLED
  startDate      DateTime
  endDate        DateTime
  contractType   String   @default("WARRANTY") // WARRANTY, SUPPORT, MAINTENANCE, SLA

  // SLA Settings
  responseTimeHours   Int?
  resolutionTimeHours Int?
  supportHours        String? // e.g., "24/7", "9-5 M-F"

  // Pricing
  contractValue     Float   @default(0)
  billingFrequency  String? // MONTHLY, QUARTERLY, ANNUALLY
  autoRenew         Boolean @default(false)
  renewalTermMonths Int?

  // Terms
  terms             String? @db.Text
  specialConditions String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  account   ClientCompany             @relation("ServiceContracts", fields: [accountId], references: [id], onDelete: Cascade)
  lineItems ServiceContractLineItem[]

  @@index([accountId])
  @@index([status])
  @@map("service_contracts")
}

model ServiceContractLineItem {
  id           String  @id @default(uuid())
  contractId   String
  productId    String?
  description  String
  quantity     Int     @default(1)
  unitPrice    Float
  totalPrice   Float
  coverageType String? // PARTS, LABOR, FULL

  contract ServiceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("service_contract_line_items")
}

// ===========================================
// SCHEDULED REPORTS
// ===========================================

model ScheduledReport {
  id         String  @id @default(uuid())
  name       String
  reportId   String? // Link to existing report
  reportType String  @default("CUSTOM") // CUSTOM, SALES, PIPELINE, ACTIVITY

  // Schedule
  frequency  String @default("WEEKLY") // DAILY, WEEKLY, MONTHLY, QUARTERLY
  dayOfWeek  Int? // 0-6 for weekly
  dayOfMonth Int? // 1-31 for monthly
  time       String @default("09:00") // HH:MM format
  timezone   String @default("America/New_York")

  // Recipients
  recipientEmails  String[]
  recipientUserIds String[]

  // Format
  format        String  @default("PDF") // PDF, EXCEL, CSV
  includeCharts Boolean @default(true)

  // Filters (stored as JSON)
  filters Json?

  // Status
  isActive   Boolean   @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  lastStatus String? // SUCCESS, FAILED, PENDING

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executions ScheduledReportExecution[]

  @@index([isActive])
  @@map("scheduled_reports")
}

model ScheduledReportExecution {
  id                String    @id @default(uuid())
  scheduledReportId String
  status            String    @default("PENDING") // PENDING, RUNNING, SUCCESS, FAILED
  startedAt         DateTime?
  completedAt       DateTime?
  fileUrl           String?
  errorMessage      String?   @db.Text
  recipientCount    Int       @default(0)

  scheduledReport ScheduledReport @relation(fields: [scheduledReportId], references: [id], onDelete: Cascade)

  @@index([scheduledReportId])
  @@map("scheduled_report_executions")
}

// ===========================================
// JOURNEY BUILDER / NURTURE FLOWS
// ===========================================

model Journey {
  id          String  @id @default(uuid())
  name        String
  description String? @db.Text
  status      String  @default("DRAFT") // DRAFT, ACTIVE, PAUSED, COMPLETED
  type        String  @default("NURTURE") // NURTURE, ONBOARDING, RE_ENGAGEMENT, UPSELL

  // Trigger
  triggerType       String @default("MANUAL") // MANUAL, LEAD_CREATED, FORM_SUBMIT, SEGMENT_ENTRY
  triggerConditions Json?

  // Settings
  entryLimit        Int? // Max contacts that can enter
  reEntryAllowed    Boolean @default(false)
  businessHoursOnly Boolean @default(false)

  // Goals
  goalType       String? // CONVERSION, ENGAGEMENT, PURCHASE
  goalConditions Json?

  // Stats
  totalEntered   Int @default(0)
  totalCompleted Int @default(0)
  totalConverted Int @default(0)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps       JourneyStep[]
  enrollments JourneyEnrollment[]

  @@index([status])
  @@map("journeys")
}

model JourneyStep {
  id        String @id @default(uuid())
  journeyId String
  stepOrder Int
  name      String
  type      String // EMAIL, WAIT, CONDITION, ACTION, SPLIT

  // Email step
  emailTemplateId String?
  emailSubject    String?
  emailBody       String? @db.Text

  // Wait step
  waitDays      Int?
  waitHours     Int?
  waitUntilTime String? // Wait until specific time

  // Condition step
  conditions Json? // Branching conditions

  // Action step
  actionType   String? // UPDATE_FIELD, CREATE_TASK, ADD_TAG, NOTIFY
  actionConfig Json?

  // Next step logic
  nextStepId String?
  yesStepId  String? // For conditions
  noStepId   String? // For conditions

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId])
  @@map("journey_steps")
}

model JourneyEnrollment {
  id            String  @id @default(uuid())
  journeyId     String
  contactId     String?
  leadId        String?
  currentStepId String?
  status        String  @default("ACTIVE") // ACTIVE, COMPLETED, EXITED, CONVERTED

  enteredAt   DateTime  @default(now())
  completedAt DateTime?
  exitedAt    DateTime?
  exitReason  String?

  // Tracking
  emailsSent    Int @default(0)
  emailsOpened  Int @default(0)
  emailsClicked Int @default(0)

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId])
  @@index([status])
  @@map("journey_enrollments")
}

// ===========================================
// SURVEY MANAGEMENT
// ===========================================

model Survey {
  id          String  @id @default(uuid())
  name        String
  description String? @db.Text
  status      String  @default("DRAFT") // DRAFT, ACTIVE, CLOSED
  type        String  @default("SATISFACTION") // SATISFACTION, NPS, FEEDBACK, CUSTOM

  // Settings
  isAnonymous        Boolean @default(false)
  allowMultiple      Boolean @default(false)
  showProgressBar    Boolean @default(true)
  randomizeQuestions Boolean @default(false)

  // Appearance
  headerImage     String?
  thankYouMessage String? @db.Text
  redirectUrl     String?

  // Schedule
  startDate DateTime?
  endDate   DateTime?

  // Stats
  totalResponses    Int  @default(0)
  avgCompletionTime Int? // in seconds

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions SurveyQuestion[]
  responses SurveyResponse[]

  @@index([status])
  @@map("surveys")
}

model SurveyQuestion {
  id            String @id @default(uuid())
  surveyId      String
  questionOrder Int
  questionText  String @db.Text
  questionType  String // TEXT, TEXTAREA, SINGLE_CHOICE, MULTIPLE_CHOICE, RATING, NPS, DATE

  // Options for choice questions
  options String[]

  // Validation
  isRequired Boolean @default(false)
  minLength  Int?
  maxLength  Int?
  minValue   Int?
  maxValue   Int?

  // Conditional logic
  showIf Json? // Show based on previous answers

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@index([surveyId])
  @@map("survey_questions")
}

model SurveyResponse {
  id        String  @id @default(uuid())
  surveyId  String
  contactId String?
  leadId    String?

  // Respondent info (for anonymous)
  respondentEmail String?
  respondentName  String?

  // Metadata
  ipAddress      String?
  userAgent      String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  completionTime Int? // in seconds

  status String @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, ABANDONED

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@index([surveyId])
  @@map("survey_responses")
}

model SurveyAnswer {
  id         String @id @default(uuid())
  responseId String
  questionId String

  // Answer data
  textAnswer      String?  @db.Text
  numberAnswer    Float?
  selectedOptions String[]

  createdAt DateTime @default(now())

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([questionId])
  @@map("survey_answers")
}

// ===========================================
// EVENT MANAGEMENT (Marketing Events)
// ===========================================

model MarketingEvent {
  id          String  @id @default(uuid())
  name        String
  description String? @db.Text
  type        String  @default("WEBINAR") // WEBINAR, CONFERENCE, WORKSHOP, MEETUP, TRADE_SHOW
  status      String  @default("DRAFT") // DRAFT, PUBLISHED, CANCELLED, COMPLETED

  // Date & Time
  startDateTime DateTime
  endDateTime   DateTime
  timezone      String   @default("America/New_York")
  isAllDay      Boolean  @default(false)

  // Location
  locationType    String  @default("ONLINE") // ONLINE, IN_PERSON, HYBRID
  venue           String?
  address         String?
  city            String?
  state           String?
  country         String?
  virtualUrl      String?
  virtualPlatform String? // ZOOM, TEAMS, WEBEX, CUSTOM

  // Capacity
  maxAttendees     Int?
  currentAttendees Int     @default(0)
  waitlistEnabled  Boolean @default(false)

  // Registration
  registrationRequired Boolean   @default(true)
  registrationDeadline DateTime?
  registrationFee      Float?

  // Content
  agenda      String? @db.Text
  speakers    Json? // Array of speaker info
  bannerImage String?

  // Campaign link
  campaignId String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  registrations MarketingEventRegistration[]
  sessions      MarketingEventSession[]

  @@index([status])
  @@index([startDateTime])
  @@map("marketing_events")
}

model MarketingEventSession {
  id           String   @id @default(uuid())
  eventId      String
  name         String
  description  String?  @db.Text
  startTime    DateTime
  endTime      DateTime
  location     String? // Room or virtual link
  speakers     Json?
  maxAttendees Int?

  event MarketingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("marketing_event_sessions")
}

model MarketingEventRegistration {
  id        String  @id @default(uuid())
  eventId   String
  contactId String?
  leadId    String?

  // Registrant info
  firstName String
  lastName  String
  email     String
  phone     String?
  company   String?
  jobTitle  String?

  // Registration details
  status       String    @default("REGISTERED") // REGISTERED, CONFIRMED, WAITLISTED, CANCELLED, ATTENDED, NO_SHOW
  registeredAt DateTime  @default(now())
  confirmedAt  DateTime?
  cancelledAt  DateTime?

  // Check-in
  checkedInAt DateTime?
  checkedInBy String?

  // Payment
  paymentStatus String? // PENDING, PAID, REFUNDED
  paymentAmount Float?

  // Custom questions
  customResponses Json?

  // Notes
  notes String? @db.Text

  event MarketingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([email])
  @@map("marketing_event_registrations")
}

// ===========================================
// CPQ (Configure, Price, Quote)
// ===========================================

model ProductBundle {
  id          String  @id @default(uuid())
  name        String
  description String? @db.Text
  bundleType  String  @default("STATIC") // STATIC, CONFIGURABLE
  isActive    Boolean @default(true)

  // Pricing
  basePrice       Float?
  discountPercent Float? // Bundle discount

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ProductBundleItem[]

  @@map("product_bundles")
}

model ProductBundleItem {
  id         String  @id @default(uuid())
  bundleId   String
  productId  String
  quantity   Int     @default(1)
  isRequired Boolean @default(true)
  isDefault  Boolean @default(true)
  sortOrder  Int     @default(0)

  bundle ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@index([bundleId])
  @@map("product_bundle_items")
}

model ProductRule {
  id          String  @id @default(uuid())
  name        String
  description String? @db.Text
  ruleType    String // VALIDATION, SELECTION, FILTER, PRICING
  isActive    Boolean @default(true)

  // Conditions
  conditions Json // When to apply the rule

  // Actions
  actions Json // What to do

  // For pricing rules
  discountType  String? // PERCENTAGE, FIXED, TIERED
  discountValue Float?

  // Scope
  productIds  String[] // Apply to specific products
  categoryIds String[] // Apply to categories

  priority Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_rules")
}

model GuidedSellingQuestion {
  id            String   @id @default(uuid())
  questionText  String
  questionType  String // SINGLE_CHOICE, MULTIPLE_CHOICE, NUMBER, TEXT
  options       String[]
  helpText      String?
  questionOrder Int
  isRequired    Boolean  @default(true)
  isActive      Boolean  @default(true)

  // Filtering logic
  filterConditions Json? // Which products to show based on answer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guided_selling_questions")
}

// ===========================================
// EMAIL & CALENDAR SYNC
// ===========================================

model EmailSyncAccount {
  id       String @id @default(uuid())
  userId   String
  provider String // GMAIL, OUTLOOK, EXCHANGE, IMAP
  email    String

  // OAuth tokens (encrypted)
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  tokenExpiry  DateTime?

  // IMAP/SMTP settings
  imapHost String?
  imapPort Int?
  smtpHost String?
  smtpPort Int?

  // Sync settings
  syncEnabled   Boolean   @default(true)
  syncDirection String    @default("BOTH") // INBOUND, OUTBOUND, BOTH
  syncFolders   String[]
  lastSyncAt    DateTime?
  syncStatus    String? // OK, ERROR, SYNCING
  syncError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, email])
  @@map("email_sync_accounts")
}

model CalendarSyncAccount {
  id           String  @id @default(uuid())
  userId       String
  provider     String // GOOGLE, OUTLOOK, EXCHANGE, CALDAV
  email        String
  calendarId   String?
  calendarName String?

  // OAuth tokens (encrypted)
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  tokenExpiry  DateTime?

  // Sync settings
  syncEnabled     Boolean   @default(true)
  syncDirection   String    @default("BOTH") // INBOUND, OUTBOUND, BOTH
  defaultReminder Int? // minutes before event
  lastSyncAt      DateTime?
  syncStatus      String?
  syncError       String?

  // Color mapping
  colorMapping Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, email])
  @@map("calendar_sync_accounts")
}

// ============================================
// FIELD SERVICE MANAGEMENT
// ============================================

enum WorkOrderStatus {
  NEW
  PENDING
  OPEN
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
  CLOSED
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  EMERGENCY
}

enum ServiceAppointmentStatus {
  NONE
  SCHEDULED
  DISPATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  CANNOT_COMPLETE
}

enum TimeSheetStatus {
  NEW
  SUBMITTED
  APPROVED
  REJECTED
}

enum AbsenceType {
  VACATION
  SICK
  PERSONAL
  TRAINING
  JURY_DUTY
  BEREAVEMENT
  OTHER
}

enum ShiftTimeSlotType {
  NORMAL
  EXTENDED
  ON_CALL
  BREAK
}

enum MaintenanceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUALLY
  ANNUALLY
}

model ServiceTerritory {
  id          String   @id @default(uuid())
  name        String
  type        String   @default("PRIMARY") // PRIMARY, SECONDARY, RELOCATION
  parentId    String?
  description String?  @db.Text
  city        String?
  state       String?
  country     String?
  latitude    Float?
  longitude   Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent             ServiceTerritory?    @relation("TerritoryHierarchyFS", fields: [parentId], references: [id])
  children           ServiceTerritory[]   @relation("TerritoryHierarchyFS")
  members            TerritoryMember[]
  crews              ServiceCrew[]
  workOrders         WorkOrder[]
  appointments       ServiceAppointment[]
  shifts             Shift[]
  fieldServiceAssets FieldServiceAsset[]
  maintenancePlans   MaintenancePlan[]
  serviceResources   ServiceResource[]

  @@index([parentId])
  @@index([isActive])
  @@map("service_territories")
}

model OperatingHours {
  id             String   @id @default(uuid())
  name           String
  timezone       String   @default("America/New_York")
  mondayStart    String?
  mondayEnd      String?
  tuesdayStart   String?
  tuesdayEnd     String?
  wednesdayStart String?
  wednesdayEnd   String?
  thursdayStart  String?
  thursdayEnd    String?
  fridayStart    String?
  fridayEnd      String?
  saturdayStart  String?
  saturdayEnd    String?
  sundayStart    String?
  sundayEnd      String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("operating_hours")
}

model ServiceResource {
  id                String   @id @default(uuid())
  name              String
  resourceType      String   @default("TECHNICIAN") // TECHNICIAN, DISPATCHER, CREW_MEMBER
  email             String?
  phone             String?
  isActive          Boolean  @default(true)
  territoryId       String?
  efficiencyRating  Float?
  travelSpeed       Float?
  maxTravelDistance Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  territory    ServiceTerritory?      @relation(fields: [territoryId], references: [id])
  skills       ServiceResourceSkill[]
  territories  TerritoryMember[]
  absences     ResourceAbsence[]
  appointments ServiceAppointment[]
  shifts       Shift[]
  timeSheets   TimeSheet[]
  timeEntries  TimeSheetEntry[]
  leadCrew     ServiceCrew[]          @relation("CrewLead")

  @@index([territoryId])
  @@index([isActive])
  @@map("service_resources")
}

model Skill {
  id          String   @id @default(uuid())
  name        String
  skillType   String   @default("TECHNICAL") // TECHNICAL, CERTIFICATION, LANGUAGE
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resources ServiceResourceSkill[]

  @@map("skills")
}

model ServiceResourceSkill {
  id             String    @id @default(uuid())
  resourceId     String
  skillId        String
  skillLevel     String    @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  effectiveStart DateTime  @default(now())
  effectiveEnd   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  resource ServiceResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  skill    Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([resourceId, skillId])
  @@index([resourceId])
  @@index([skillId])
  @@map("service_resource_skills")
}

model TerritoryMember {
  id             String    @id @default(uuid())
  resourceId     String
  territoryId    String
  membershipType String    @default("PRIMARY") // PRIMARY, SECONDARY, RELOCATION
  effectiveStart DateTime  @default(now())
  effectiveEnd   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  resource  ServiceResource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  territory ServiceTerritory @relation(fields: [territoryId], references: [id], onDelete: Cascade)

  @@unique([resourceId, territoryId])
  @@index([resourceId])
  @@index([territoryId])
  @@map("territory_members")
}

model ServiceCrew {
  id             String   @id @default(uuid())
  name           String
  crewSize       Int      @default(1)
  leadId         String?
  territoryId    String?
  specialization String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lead      ServiceResource?  @relation("CrewLead", fields: [leadId], references: [id])
  territory ServiceTerritory? @relation(fields: [territoryId], references: [id])

  @@index([leadId])
  @@index([territoryId])
  @@map("service_crews")
}

model ResourceAbsence {
  id          String      @id @default(uuid())
  resourceId  String
  type        AbsenceType @default(OTHER)
  startTime   DateTime
  endTime     DateTime
  description String?     @db.Text
  approvedBy  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  resource ServiceResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([startTime])
  @@map("resource_absences")
}

model WorkType {
  id                       String   @id @default(uuid())
  name                     String
  estimatedDurationMinutes Int      @default(60)
  skillRequirement         String?
  blockTimeBefore          Int      @default(0)
  blockTimeAfter           Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  workOrders       WorkOrder[]
  lineItems        WorkOrderLineItem[]
  maintenancePlans MaintenancePlan[]

  @@map("work_types")
}

model WorkOrder {
  id              String            @id @default(uuid())
  workOrderNumber String            @unique @default(uuid())
  subject         String
  description     String?           @db.Text
  accountId       String?
  contactName     String?
  contactPhone    String?
  contactEmail    String?
  budget          Float?
  region          String?
  district        String?
  market          String?
  territoryId     String?
  workTypeId      String?
  priority        WorkOrderPriority @default(MEDIUM)
  status          WorkOrderStatus   @default(NEW)
  address         String?
  city            String?
  state           String?
  latitude        Float?
  longitude       Float?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  account      ClientCompany?       @relation(fields: [accountId], references: [id])
  territory    ServiceTerritory?    @relation(fields: [territoryId], references: [id])
  workType     WorkType?            @relation(fields: [workTypeId], references: [id])
  lineItems    WorkOrderLineItem[]
  appointments ServiceAppointment[]
  timeEntries  TimeSheetEntry[]

  @@index([accountId])
  @@index([territoryId])
  @@index([workTypeId])
  @@index([status])
  @@index([priority])
  @@map("work_orders")
}

model WorkOrderLineItem {
  id              String   @id @default(uuid())
  workOrderId     String
  lineItemNumber  Int      @default(1)
  description     String?  @db.Text
  workTypeId      String?
  status          String   @default("NEW")
  durationMinutes Int      @default(60)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workType  WorkType? @relation(fields: [workTypeId], references: [id])

  @@index([workOrderId])
  @@index([workTypeId])
  @@map("work_order_line_items")
}

model ServiceAppointment {
  id                String                   @id @default(uuid())
  appointmentNumber String                   @unique @default(uuid())
  workOrderId       String?
  subject           String
  status            ServiceAppointmentStatus @default(NONE)
  scheduledStart    DateTime?
  scheduledEnd      DateTime?
  actualStart       DateTime?
  actualEnd         DateTime?
  durationMinutes   Int                      @default(60)
  resourceId        String?
  territoryId       String?
  address           String?
  city              String?
  state             String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  workOrder WorkOrder?        @relation(fields: [workOrderId], references: [id])
  resource  ServiceResource?  @relation(fields: [resourceId], references: [id])
  territory ServiceTerritory? @relation(fields: [territoryId], references: [id])

  @@index([workOrderId])
  @@index([resourceId])
  @@index([territoryId])
  @@index([status])
  @@index([scheduledStart])
  @@map("service_appointments")
}

model Shift {
  id           String            @id @default(uuid())
  territoryId  String?
  label        String
  startTime    DateTime
  endTime      DateTime
  timeSlotType ShiftTimeSlotType @default(NORMAL)
  resourceId   String?
  status       String            @default("CONFIRMED")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  territory ServiceTerritory? @relation(fields: [territoryId], references: [id])
  resource  ServiceResource?  @relation(fields: [resourceId], references: [id])

  @@index([territoryId])
  @@index([resourceId])
  @@index([startTime])
  @@map("shifts")
}

model TimeSheet {
  id         String          @id @default(uuid())
  resourceId String
  startDate  DateTime
  endDate    DateTime
  totalHours Float           @default(0)
  status     TimeSheetStatus @default(NEW)
  approvedBy String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  resource ServiceResource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  entries  TimeSheetEntry[]

  @@index([resourceId])
  @@index([status])
  @@map("time_sheets")
}

model TimeSheetEntry {
  id            String   @id @default(uuid())
  timeSheetId   String
  resourceId    String
  workOrderId   String?
  type          String   @default("WORK") // WORK, TRAVEL, BREAK
  startTime     DateTime
  endTime       DateTime
  durationHours Float    @default(0)
  description   String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  timeSheet TimeSheet       @relation(fields: [timeSheetId], references: [id], onDelete: Cascade)
  resource  ServiceResource @relation(fields: [resourceId], references: [id])
  workOrder WorkOrder?      @relation(fields: [workOrderId], references: [id])

  @@index([timeSheetId])
  @@index([resourceId])
  @@index([workOrderId])
  @@map("time_sheet_entries")
}

model FieldServiceAsset {
  id              String    @id @default(uuid())
  name            String
  serialNumber    String?
  accountName     String?
  productName     String?
  installDate     DateTime?
  warrantyEnd     DateTime?
  territoryId     String?
  address         String?
  lastServiceDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  territory        ServiceTerritory? @relation(fields: [territoryId], references: [id])
  maintenancePlans MaintenancePlan[]

  @@index([territoryId])
  @@index([serialNumber])
  @@map("field_service_assets")
}

model MaintenancePlan {
  id                String               @id @default(uuid())
  title             String
  workTypeId        String?
  assetId           String?
  frequency         MaintenanceFrequency @default(MONTHLY)
  nextSuggestedDate DateTime?
  territoryId       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  workType  WorkType?          @relation(fields: [workTypeId], references: [id])
  asset     FieldServiceAsset? @relation(fields: [assetId], references: [id])
  territory ServiceTerritory?  @relation(fields: [territoryId], references: [id])

  @@index([workTypeId])
  @@index([assetId])
  @@index([territoryId])
  @@map("maintenance_plans")
}

model SchedulingPolicy {
  id                     String   @id @default(uuid())
  name                   String
  policyType             String   @default("STANDARD") // STANDARD, EMERGENCY, HIGH_PRIORITY
  travelTimeOptimization Boolean  @default(true)
  skillMatching          Boolean  @default(true)
  priorityWeight         Int      @default(50)
  territoryPreference    String   @default("PRIMARY") // PRIMARY, ANY
  maxTravelDistance      Float?
  sameDayPolicy          String   @default("ALLOW") // ALLOW, PREFER, REQUIRE
  emergencyOverride      Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("scheduling_policies")
}

