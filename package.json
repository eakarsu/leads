{
  "name": "leadgenflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && bash scripts/prepare-standalone.sh",
    "start": "next start",
    "lint": "eslint app/api/lead-operations app/api/leads/route.ts app/api/leads/\\[id\\]/route.ts app/api/leads/\\[id\\]/transition app/api/leads/\\[id\\]/consent app/api/leads/\\[id\\]/handoff app/api/leads/\\[id\\]/conversion app/leads app/outreach app/settings app/dashboard app/login app/opt-out components/DashboardLayout.tsx lib/lead-operations lib/auth.ts lib/email.ts middleware.ts scripts/lead-worker.ts scripts/provision-admin.ts scripts/revoke-user-sessions.ts tests/lead-operations",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test",
    "test": "tsx --test tests/lead-operations/*.test.ts",
    "test:e2e": "playwright test tests/e2e",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:provision": "tsx scripts/provision-admin.ts",
    "create-admin": "tsx scripts/provision-admin.ts",
    "db:backup": "bash scripts/backup.sh",
    "db:restore": "bash scripts/restore.sh",
    "db:studio": "prisma studio",
    "auth:revoke": "tsx scripts/revoke-user-sessions.ts",
    "worker": "tsx scripts/lead-worker.ts",
    "worker:once": "tsx scripts/lead-worker.ts --once",
    "audit:dependencies": "node scripts/audit-dependencies.mjs && node scripts/audit-dependencies.mjs --all"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "@mui/material-nextjs": "^7.3.5",
    "@mui/x-date-pickers": "^7.28.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "date-fns": "^3.6.0",
    "next": "^16.2.11",
    "next-auth": "^4.24.15",
    "pg": "^8.16.3",
    "prisma": "^7.8.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "reactflow": "^11.11.4",
    "recharts": "^3.7.0",
    "resend": "^6.17.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "next-auth": {
      "uuid": "11.1.1"
    }
  }
}
