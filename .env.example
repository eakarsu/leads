# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leadgenflow

# OpenRouter AI
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Available models: anthropic/claude-3.5-sonnet, anthropic/claude-3-haiku, anthropic/claude-3-opus
# Note: Visit https://openrouter.ai/settings/preferences to configure provider settings
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32
