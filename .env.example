# Required application configuration
DATABASE_URL=postgresql://app_user:change_me@127.0.0.1:5432/lead_operations
POSTGRES_DB=lead_operations
POSTGRES_USER=app_user
POSTGRES_PASSWORD=replace-with-a-local-development-password
NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
PUBLIC_APP_URL=http://127.0.0.1:3000
OUTREACH_OPT_OUT_SECRET=replace-with-at-least-32-random-characters

# Outbound email worker
RESEND_API_KEY=
EMAIL_FROM=

# Optional hard allowlist for connector delivery hosts
CONNECTOR_ALLOWED_HOSTS=

# Connector secrets are referenced by their variable names in the database.
# Examples only; use a secret manager in production.
CRM_BEARER_TOKEN=
CRM_WEBHOOK_SECRET=

# Explicit one-time provisioning (remove after use)
PROVISION_ADMIN_EMAIL=
PROVISION_ADMIN_PASSWORD=
PROVISION_ADMIN_NAME=
PROVISION_COMPANY_NAME=
